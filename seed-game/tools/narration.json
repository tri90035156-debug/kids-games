[
 {
  "key": "g.ok1",
  "id": "9e30ee5e7708",
  "text": "答對了！"
 },
 {
  "key": "g.ok2",
  "id": "3fd30ec122ba",
  "text": "好棒喔！"
 },
 {
  "key": "g.ok3",
  "id": "ac75b681b350",
  "text": "你好厲害！"
 },
 {
  "key": "g.no1",
  "id": "3b6253c40a96",
  "text": "再試試看喔。"
 },
 {
  "key": "g.no2",
  "id": "d1268e26f792",
  "text": "不要緊，再想一想。"
 },
 {
  "key": "g.hint",
  "id": "9505d58f10e4",
  "text": "看看有發亮的那一個。"
 },
 {
  "key": "g.order",
  "id": "e6f7316cfbf9",
  "text": "順序不對喔，再找找看。"
 },
 {
  "key": "intro.hi",
  "id": "bd7834d5ea83",
  "text": "你好！我們一起來認識種子。"
 },
 {
  "key": "intro.found",
  "id": "e4b7b136ff7d",
  "text": "每一顆種子，都藏著一棵樹。你想知道種子的祕密嗎？"
 },
 {
  "key": "intro.press",
  "id": "054c4d2ead3a",
  "text": "按鍵盤上的 S，我們出發！"
 },
 {
  "key": "c1.title",
  "id": "5df8c4cbd6ba",
  "text": "第一關，找種子"
 },
 {
  "key": "c2.title",
  "id": "882eabb89666",
  "text": "第二關，種子怎麼來"
 },
 {
  "key": "c3.title",
  "id": "ac9704bc35cf",
  "text": "第三關，種子變成樹"
 },
 {
  "key": "c4.title",
  "id": "b0a227247c4a",
  "text": "第四關，認識種子"
 },
 {
  "key": "c5.title",
  "id": "db84bd88d179",
  "text": "第五關，種子配對"
 },
 {
  "key": "c6.title",
  "id": "1927c97c5ead",
  "text": "第六關，種子去旅行"
 },
 {
  "key": "c7.title",
  "id": "7a8d41f60fa9",
  "text": "第七關，種子的一生"
 },
 {
  "key": "c8.title",
  "id": "240837eeeebe",
  "text": "加碼關，最早的種子"
 },
 {
  "key": "c1.intro",
  "id": "a7d34c759d55",
  "text": "種子藏起來了！點一點，看看裡面有沒有種子。"
 },
 {
  "key": "c1.apple",
  "id": "f4a06aa3ae67",
  "text": "蘋果裡面，有小小的黑種子。"
 },
 {
  "key": "c1.mango",
  "id": "b8676d934dbf",
  "text": "芒果中間有一顆大大的核，種子就藏在核裡面。"
 },
 {
  "key": "c1.pine",
  "id": "cfbcdaeae384",
  "text": "松果的鱗片裡，藏著松樹的種子。"
 },
 {
  "key": "c1.done",
  "id": "669ecb4d9152",
  "text": "原來種子藏在果實和松果裡面！"
 },
 {
  "key": "c1.q",
  "id": "5a4649af4add",
  "text": "種子藏在哪裡？"
 },
 {
  "key": "c1.ok",
  "id": "a1b2ceff49d1",
  "text": "對！種子藏在果實裡，或是松果裡。"
 },
 {
  "key": "c2.intro",
  "id": "5f8ec6d41293",
  "text": "種子是怎麼來的呢？照順序，點一點。"
 },
 {
  "key": "c2.n1",
  "id": "d6896b254841",
  "text": "樹開花了。花的裡面，有很小很小的種子寶寶。"
 },
 {
  "key": "c2.n2",
  "id": "44e2fde90630",
  "text": "蜜蜂來採蜜，把花粉送給別朵花。"
 },
 {
  "key": "c2.n3",
  "id": "8d7ed6c794e5",
  "text": "有了花粉，種子寶寶才會長大。花謝了，種子和果實一起長。"
 },
 {
  "key": "c2.n4",
  "id": "597316b73855",
  "text": "果實熟了，裡面的種子也熟了。果實是保護種子的房子。"
 },
 {
  "key": "c2.done",
  "id": "4d142f0b3658",
  "text": "種子在花裡面就開始了，和果實一起長大。"
 },
 {
  "key": "c2.q",
  "id": "516780e7f6af",
  "text": "種子是在哪裡開始長的？"
 },
 {
  "key": "c2.ok",
  "id": "2b7e2d896ba2",
  "text": "對！種子在花裡面，就開始長了。"
 },
 {
  "key": "c3.intro",
  "id": "a8a5f748398d",
  "text": "我們來種一棵樹！點一下泥土，把種子種進去。"
 },
 {
  "key": "c3.s1",
  "id": "d937015e2e43",
  "text": "種子睡在土裡了。"
 },
 {
  "key": "c3.k1",
  "id": "fb29c484e572",
  "text": "按 W，幫種子澆水。"
 },
 {
  "key": "c3.s2",
  "id": "3b938c130c3a",
  "text": "種子喝飽了水，變胖胖的。"
 },
 {
  "key": "c3.k2",
  "id": "f85fa1c17200",
  "text": "再按 W，多喝一點水。"
 },
 {
  "key": "c3.s3",
  "id": "5c6b1bb63653",
  "text": "種子裂開了，小根先長出來，往下抓住土。"
 },
 {
  "key": "c3.k3",
  "id": "f4e174d01b21",
  "text": "按 S，太陽公公出來了。"
 },
 {
  "key": "c3.s4",
  "id": "2ab1f5f1e769",
  "text": "小芽往上長，探出了頭。"
 },
 {
  "key": "c3.k4",
  "id": "3e901c73e3f5",
  "text": "再按 S，曬曬太陽。"
 },
 {
  "key": "c3.s5",
  "id": "5b39d3c10888",
  "text": "長出綠綠的小葉子。"
 },
 {
  "key": "c3.k5",
  "id": "92bd8391b6fd",
  "text": "按 W，再澆一點水。"
 },
 {
  "key": "c3.s6",
  "id": "a22ab644763e",
  "text": "小樹苗長高了。"
 },
 {
  "key": "c3.k6",
  "id": "47f47aa5d081",
  "text": "按 S，再曬曬太陽。"
 },
 {
  "key": "c3.s7",
  "id": "55c3ce62e6e7",
  "text": "長成大樹了！不過，要好多好多年喔。"
 },
 {
  "key": "c3.done",
  "id": "2ac0ee2a6c3b",
  "text": "種子發芽、長大，就變成一棵樹了！"
 },
 {
  "key": "c3.q",
  "id": "1129e1b7d678",
  "text": "種子發芽的時候，先長出什麼？"
 },
 {
  "key": "c3.ok",
  "id": "d4d27545e6d6",
  "text": "對！種子先長出根，往下抓住土。"
 },
 {
  "key": "c4.intro",
  "id": "1e1d510c4c74",
  "text": "這些都是樹的種子。點一點，看看它們長什麼樣子。"
 },
 {
  "key": "c4.done",
  "id": "718d65f82f71",
  "text": "你認識了六種樹的種子！"
 },
 {
  "key": "info.oak",
  "id": "1ea57d0b930c",
  "text": "橡實是橡樹的種子。它戴著一頂小帽子。"
 },
 {
  "key": "info.pine",
  "id": "3a4a801fbc69",
  "text": "松果裡面，藏著松樹的種子，叫做松子。"
 },
 {
  "key": "info.maple",
  "id": "3c70c3adeb86",
  "text": "楓樹的種子有翅膀，會像小直升機一樣轉圈圈。"
 },
 {
  "key": "info.coconut",
  "id": "4fa948bf84e4",
  "text": "椰子是椰子樹的種子。它很大顆，可以漂在海上。"
 },
 {
  "key": "info.mango",
  "id": "14ec5fa33695",
  "text": "芒果的大核裡面，就是芒果樹的種子。"
 },
 {
  "key": "info.apple",
  "id": "7d29ea71f31e",
  "text": "蘋果的種子小小黑黑的，就在蘋果的中間。"
 },
 {
  "key": "c5.intro",
  "id": "4934c14eb128",
  "text": "看看這個種子，它會長成哪一種樹呢？"
 },
 {
  "key": "c6.intro",
  "id": "2546b9f66dac",
  "text": "種子不會走路。它們要怎麼去旅行呢？"
 },
 {
  "key": "c6.q1",
  "id": "2dd8fdbb2a63",
  "text": "楓樹的種子有翅膀。誰會帶它去旅行？"
 },
 {
  "key": "c6.ok1",
  "id": "39a4bdb84f7b",
  "text": "對！風一吹，種子就像小直升機，飛到好遠的地方。"
 },
 {
  "key": "c6.q2",
  "id": "ebd7ef64cc4a",
  "text": "椰子掉進海裡了。誰會帶它去旅行？"
 },
 {
  "key": "c6.ok2",
  "id": "e95ff64cfc78",
  "text": "對！椰子能漂在水上，漂到好遠的小島。"
 },
 {
  "key": "c6.q3",
  "id": "d3873a403108",
  "text": "松鼠最愛吃橡實，還會把它藏起來。誰會帶橡實去旅行？"
 },
 {
  "key": "c6.ok3",
  "id": "0a6411275290",
  "text": "對！松鼠把橡實埋起來，忘記的橡實，就會長成橡樹。"
 },
 {
  "key": "c6.done",
  "id": "2bb3c1f28119",
  "text": "風、水、小動物，都是種子的好朋友。"
 },
 {
  "key": "c7.intro",
  "id": "a445b5362cf5",
  "text": "最後一關！把種子的一生，排一排。"
 },
 {
  "key": "c7.n1",
  "id": "507230ce42db",
  "text": "一顆種子，睡在土裡。"
 },
 {
  "key": "c7.n2",
  "id": "0334f5de2cb8",
  "text": "種子發芽了。"
 },
 {
  "key": "c7.n3",
  "id": "df9b2e9ed242",
  "text": "小樹苗長成大樹。"
 },
 {
  "key": "c7.n4",
  "id": "07937c357277",
  "text": "種子長成的大樹，開花了。"
 },
 {
  "key": "c7.n5",
  "id": "24856a396bd5",
  "text": "花變成果實，裡面有新的種子。"
 },
 {
  "key": "c7.done",
  "id": "6e81837920a5",
  "text": "種子長成大樹，大樹開花、結果，又有新的種子。一直一直轉圈圈。"
 },
 {
  "key": "c8.intro",
  "id": "09ebeb2c19cd",
  "text": "很久很久以前，世界上還沒有種子。照順序，點一點。"
 },
 {
  "key": "c8.n1",
  "id": "9293f2bec106",
  "text": "最早，植物用孢子生寶寶。孢子像粉末，很小很小，沒有殼，也沒有便當。"
 },
 {
  "key": "c8.n2",
  "id": "344915ba0615",
  "text": "後來，有些植物把寶寶包進小殼裡，還帶了便當，這就是種子。像松樹，種子藏在松果裡，沒有花。"
 },
 {
  "key": "c8.n3",
  "id": "ead4bd759eb6",
  "text": "又過了很久很久，才有了花和果實。"
 },
 {
  "key": "c8.done",
  "id": "bab8ce8c7404",
  "text": "所以，種子比花還要早。第一顆種子，不是突然冒出來的，是慢慢、慢慢變成的。"
 },
 {
  "key": "c8.q",
  "id": "116d570b7b95",
  "text": "哪一個先出現？"
 },
 {
  "key": "c8.ok",
  "id": "c4255a3224e9",
  "text": "對！種子比花先出現。"
 },
 {
  "key": "fin.hi",
  "id": "1baca52bb6a5",
  "text": "你好厲害！你是種子小博士！"
 },
 {
  "key": "fin.task",
  "id": "29b3fd1e85f8",
  "text": "回家找一找，哪些種子可以種？"
 },
 {
  "key": "q5.oak",
  "id": "12fe0f717200",
  "text": "這是橡實，它會長成哪一種樹？"
 },
 {
  "key": "ok5.oak",
  "id": "a5304c0a9b8e",
  "text": "對！橡實會長成橡樹。"
 },
 {
  "key": "q5.pine",
  "id": "1c4d296bd052",
  "text": "這是松果，它會長成哪一種樹？"
 },
 {
  "key": "ok5.pine",
  "id": "151c63181ed8",
  "text": "對！松果會長成松樹。"
 },
 {
  "key": "q5.maple",
  "id": "a01fa1c90bd5",
  "text": "這是有翅膀的種子，它會長成哪一種樹？"
 },
 {
  "key": "ok5.maple",
  "id": "6c9b8e15f3fd",
  "text": "對！有翅膀的種子會長成楓樹。"
 },
 {
  "key": "q5.coconut",
  "id": "b9f471d2c183",
  "text": "這是椰子，它會長成哪一種樹？"
 },
 {
  "key": "ok5.coconut",
  "id": "1f1191838839",
  "text": "對！椰子會長成椰子樹。"
 },
 {
  "key": "q5.mango",
  "id": "093f974e8e46",
  "text": "這是芒果核，它會長成哪一種樹？"
 },
 {
  "key": "ok5.mango",
  "id": "5ee575645e86",
  "text": "對！芒果核會長成芒果樹。"
 },
 {
  "key": "q5.apple",
  "id": "40ea10ad329a",
  "text": "這是蘋果籽，它會長成哪一種樹？"
 },
 {
  "key": "ok5.apple",
  "id": "806e8041e51e",
  "text": "對！蘋果籽會長成蘋果樹。"
 }
]