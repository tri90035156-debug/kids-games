[
 {
  "key": "g.no1",
  "id": "3b6253c40a96",
  "text": "再試試看喔。"
 },
 {
  "key": "g.no2",
  "id": "d1268e26f792",
  "text": "不要緊，再想一想。"
 },
 {
  "key": "g.order",
  "id": "0ec183fa2bfd",
  "text": "時間不對喔，再想一想。"
 },
 {
  "key": "intro.hi",
  "id": "0409ac0e966a",
  "text": "你好！你聽過 AI 嗎？"
 },
 {
  "key": "intro.found",
  "id": "a2e61ec0a1f3",
  "text": "AI 是人做出來，會學習的電腦。它是怎麼來的呢？"
 },
 {
  "key": "intro.press",
  "id": "054c4d2ead3a",
  "text": "按鍵盤上的 S，我們出發！"
 },
 {
  "key": "c1.title",
  "id": "82fccb3bd4a0",
  "text": "第一關，人愛做工具"
 },
 {
  "key": "c2.title",
  "id": "201e6411fa21",
  "text": "第二關，電腦照著做"
 },
 {
  "key": "c3.title",
  "id": "14e66074ed49",
  "text": "第三關，規則不夠用"
 },
 {
  "key": "c4.title",
  "id": "d9f8e01f1f4d",
  "text": "第四關，你來當老師"
 },
 {
  "key": "c5.title",
  "id": "e82cf493b274",
  "text": "第五關，猜錯了再改"
 },
 {
  "key": "c6.title",
  "id": "183f3ada0d55",
  "text": "第六關，學大腦連一連"
 },
 {
  "key": "c7.title",
  "id": "949286ebd037",
  "text": "第七關，例子要很多"
 },
 {
  "key": "c8.title",
  "id": "e57ff70b96de",
  "text": "第八關，電腦長大了"
 },
 {
  "key": "c9.title",
  "id": "5677190823b7",
  "text": "第九關，猜下一個字"
 },
 {
  "key": "c10.title",
  "id": "724df6e8bcba",
  "text": "第十關，AI 也會出錯"
 },
 {
  "key": "c1.intro",
  "id": "ad94bd1b3243",
  "text": "人很聰明，會做工具來幫自己。把工具拖到它幫忙的地方。"
 },
 {
  "key": "c1.hammer",
  "id": "7993ae7740b9",
  "text": "槌子，幫手變得更有力氣。"
 },
 {
  "key": "c1.bike",
  "id": "b490e0260638",
  "text": "腳踏車，幫腳跑得更遠。"
 },
 {
  "key": "c1.glasses",
  "id": "7f654c1b97dd",
  "text": "眼鏡，幫眼睛看得更清楚。"
 },
 {
  "key": "c1.phone",
  "id": "61bf01b0ce78",
  "text": "電話，幫耳朵聽到很遠的聲音。"
 },
 {
  "key": "c1.wrong",
  "id": "c7dfce9c3fd7",
  "text": "再想一想，它是幫哪裡的忙？"
 },
 {
  "key": "c1.ask",
  "id": "c72b62874bc1",
  "text": "那有沒有工具，可以幫忙想事情呢？把它拖到頭上。"
 },
 {
  "key": "c1.ai",
  "id": "b4edd59c22cc",
  "text": "人想做一個，會幫忙想事情的工具。這個夢想，就是 AI 的開始。"
 },
 {
  "key": "c1.why",
  "id": "0b034b5b9635",
  "text": "為什麼會有 AI？因為人想要一個幫手，幫忙看、幫忙聽、幫忙想。"
 },
 {
  "key": "c2.intro",
  "id": "d57893990748",
  "text": "後來，人做出了電腦。電腦算得好快，可是它只會照著人說的做。"
 },
 {
  "key": "c2.how",
  "id": "433860f8bd46",
  "text": "幫機器人排步驟，走到星星那裡。點箭頭，或按鍵盤上的方向鍵，排好了再按 G 出發。"
 },
 {
  "key": "c2.erase",
  "id": "4e01eae0a7f6",
  "text": "排錯了，可以按 X 擦掉一步。"
 },
 {
  "key": "c2.ok",
  "id": "6cf9a2ace5ee",
  "text": "走到了！機器人照著你的步驟走。"
 },
 {
  "key": "c2.bump",
  "id": "c162fafb7e46",
  "text": "機器人只會照著做，步驟不對，就走錯了。改一改，再試一次。"
 },
 {
  "key": "c2.next",
  "id": "e71185be7574",
  "text": "再來一個，這次要轉彎。"
 },
 {
  "key": "c2.done",
  "id": "e0f5c04143ec",
  "text": "電腦不會自己想，要人一步一步告訴它。這一串步驟，叫做程式。"
 },
 {
  "key": "c3.intro",
  "id": "eb4a75164814",
  "text": "人想教電腦認識貓。第一個想法是：寫一條規則。"
 },
 {
  "key": "c3.pick",
  "id": "7acd4476b3e1",
  "text": "選一條規則，按 A 或 B，看看電腦認得對不對。"
 },
 {
  "key": "c3.failA",
  "id": "1ccce6c97cc7",
  "text": "糟糕！狐狸也有尖耳朵，被當成貓了。折耳貓的耳朵不尖，反而認不出來。"
 },
 {
  "key": "c3.failB",
  "id": "7dd104f37a90",
  "text": "糟糕！狐狸和小狗也有鬍鬚，都被當成貓了。"
 },
 {
  "key": "c3.other",
  "id": "64f87d519101",
  "text": "換另一條規則試試看。"
 },
 {
  "key": "c3.done",
  "id": "f742ba39560f",
  "text": "貓有好多種樣子，規則怎麼寫，都會有例外。人想了好久，還是寫不完。"
 },
 {
  "key": "c4.intro",
  "id": "c617e15611ff",
  "text": "後來，人想到新方法：不寫規則了，給電腦看很多很多例子，讓它自己找出貓的樣子。"
 },
 {
  "key": "c4.how",
  "id": "a9a68b1d5856",
  "text": "你來當老師！把照片拖進對的籃子：是貓，還是不是貓。"
 },
 {
  "key": "c4.wrong",
  "id": "4aa216ec45dd",
  "text": "再看看，這是貓嗎？"
 },
 {
  "key": "c4.owl",
  "id": "dc5e7cfb6108",
  "text": "貓頭鷹的名字裡有貓，可是牠是鳥喔！"
 },
 {
  "key": "c4.done",
  "id": "93048df3997b",
  "text": "電腦看了好多例子，慢慢學會了。這就叫做機器學習。"
 },
 {
  "key": "c5.intro",
  "id": "8b4f39d19605",
  "text": "學好了嗎？讓電腦猜猜看。它猜對了，按 O；猜錯了，按 X。"
 },
 {
  "key": "c5.right",
  "id": "4bbf7753ed23",
  "text": "電腦猜對了！"
 },
 {
  "key": "c5.fix",
  "id": "ad4db3123792",
  "text": "電腦猜錯了。它會記住，把裡面的小旋鈕調一調。"
 },
 {
  "key": "c5.again",
  "id": "27f719956fa3",
  "text": "調好了，再猜一次。"
 },
 {
  "key": "c5.look",
  "id": "a3718942c9c4",
  "text": "再看清楚，電腦猜得對不對？"
 },
 {
  "key": "c5.done",
  "id": "07c308d6fec8",
  "text": "猜、看答案、再調一調。一次又一次，電腦就越來越會了。"
 },
 {
  "key": "c6.intro",
  "id": "2c31c0594e56",
  "text": "你的頭腦裡，有好多好多小小的神經細胞，它們手牽手，把消息傳來傳去。"
 },
 {
  "key": "c6.ai",
  "id": "d5556743182b",
  "text": "AI 學大腦，也把好多小點點連在一起，叫做神經網路。"
 },
 {
  "key": "c6.how",
  "id": "3779a10092a9",
  "text": "從左邊的點，畫一條線到中間的點，再畫到右邊的貓，讓消息傳過去。"
 },
 {
  "key": "c6.more",
  "id": "2a60bff8a428",
  "text": "連得好！每一個左邊的點，都要連上喔。"
 },
 {
  "key": "c6.go",
  "id": "2c528cc5c331",
  "text": "連好了！看，消息傳過去了：尖耳朵、有鬍鬚、毛毛的，是貓！"
 },
 {
  "key": "c6.done",
  "id": "499d725daefe",
  "text": "學習的時候，有的線會變粗，有的線會變細。AI 就是這樣，記住它學到的東西。"
 },
 {
  "key": "c7.intro",
  "id": "9396155e4e77",
  "text": "電腦要學會，需要很多很多例子。只看幾張，很容易猜錯。"
 },
 {
  "key": "c7.how",
  "id": "a5f4c7073423",
  "text": "按住按鈕，或按住空白鍵，把照片倒進電腦。放開的時候，電腦就來考試。"
 },
 {
  "key": "c7.few",
  "id": "0541ed5466f1",
  "text": "例子太少了，電腦還常常猜錯。再多倒一些。"
 },
 {
  "key": "c7.ok",
  "id": "4257d2f5bc9e",
  "text": "哇！看了好多好多例子，電腦都猜對了！"
 },
 {
  "key": "c7.done",
  "id": "1e0f0575192b",
  "text": "有的 AI，看過幾百萬張照片！要算這麼多，還要很快很快的電腦。"
 },
 {
  "key": "c8.intro",
  "id": "01d10440a70a",
  "text": "電腦也慢慢長大了。把圖片拖到時間線上，從很久以前，排到現在。"
 },
 {
  "key": "c8.n1",
  "id": "06c01afcead7",
  "text": "最早的電腦好大好大，放滿一整個房間。"
 },
 {
  "key": "c8.n2",
  "id": "999b5d14bc0c",
  "text": "有一群科學家，給會學習、會想事情的電腦夢想，取了一個名字：人工智慧，就是 AI。"
 },
 {
  "key": "c8.n3",
  "id": "128926502ffa",
  "text": "電腦變小了，可以放在家裡的桌子上。"
 },
 {
  "key": "c8.n4",
  "id": "b84b7e95166a",
  "text": "電腦變得更小，放進口袋，就是手機。"
 },
 {
  "key": "c8.n5",
  "id": "8deb63646fa8",
  "text": "電腦夠快、例子夠多，AI 終於變得好厲害，會看圖，也會聊天。"
 },
 {
  "key": "c8.done",
  "id": "27e2b850ee2a",
  "text": "AI 的夢想，很早很早就有了。可是要等電腦長大，才做得出來。"
 },
 {
  "key": "c9.intro",
  "id": "83c7b0f80cf1",
  "text": "會聊天的 AI，讀過好多好多文章。它最會玩一個遊戲：猜下一個字。"
 },
 {
  "key": "c9.you",
  "id": "9a035ffe1062",
  "text": "現在你來當 AI！把最對的詞，拖進空格。"
 },
 {
  "key": "c9.q1",
  "id": "dec1c4905790",
  "text": "小貓最喜歡吃什麼？"
 },
 {
  "key": "c9.q2",
  "id": "6c06dd62435e",
  "text": "天黑了，天上有圓圓的什麼？"
 },
 {
  "key": "c9.q3",
  "id": "7797176688b1",
  "text": "刷完牙，我要上床做什麼？"
 },
 {
  "key": "c9.ok",
  "id": "95c0fec42ffd",
  "text": "對！這個最有可能。"
 },
 {
  "key": "c9.gen",
  "id": "1b3c20727705",
  "text": "換 AI 來說故事。你每按一下空白鍵，或點一下，AI 就猜下一個詞。"
 },
 {
  "key": "c9.story",
  "id": "f78024dc4d34",
  "text": "從前有一隻小貓，牠最喜歡在太陽下面睡午覺。"
 },
 {
  "key": "c9.done",
  "id": "0c617f1af310",
  "text": "AI 就是這樣，一個詞接一個詞，說出一整句話。"
 },
 {
  "key": "c10.intro",
  "id": "5e623a1e7bfa",
  "text": "AI 很厲害，可是它也會出錯。這張圖是 AI 畫的，有三個地方怪怪的。點一點，把它們找出來！"
 },
 {
  "key": "c10.f1",
  "id": "1577a8a6a86a",
  "text": "貓怎麼有兩條尾巴？"
 },
 {
  "key": "c10.f2",
  "id": "2ae0b6558c69",
  "text": "魚怎麼長在樹上？"
 },
 {
  "key": "c10.f3",
  "id": "65253a368cc5",
  "text": "門怎麼開在屋頂上？"
 },
 {
  "key": "c10.why",
  "id": "bb2ab359ebc2",
  "text": "AI 是從例子學的。它很會猜，可是不一定每次都對。"
 },
 {
  "key": "c10.you",
  "id": "9356a978bcae",
  "text": "所以用 AI 的時候，要用你自己的頭腦想一想，也可以問問大人。"
 },
 {
  "key": "c10.wish",
  "id": "71f21f381329",
  "text": "最後一個問題：你想請 AI 幫忙做什麼？選一個你喜歡的。"
 },
 {
  "key": "c10.r1",
  "id": "6f66099dd0df",
  "text": "AI 可以幫忙翻譯，讓不同國家的人，聽懂彼此說的話。"
 },
 {
  "key": "c10.r2",
  "id": "de0772ad76d8",
  "text": "AI 可以幫醫生看身體的照片，早一點找到生病的地方。"
 },
 {
  "key": "c10.r3",
  "id": "fe54a3d0c640",
  "text": "AI 可以幫科學家數動物、看天氣，一起照顧地球。"
 },
 {
  "key": "c10.r4",
  "id": "fced087f0546",
  "text": "AI 可以陪你想故事。不過，最棒的點子，還是在你的頭腦裡。"
 },
 {
  "key": "c10.done",
  "id": "ebb62f1aaff5",
  "text": "AI 是人做出來的好幫手。要怎麼用它，由人來決定。"
 },
 {
  "key": "fin.hi",
  "id": "6390090a9cfb",
  "text": "你好厲害！你知道 AI 是怎麼來的了！"
 },
 {
  "key": "fin.task",
  "id": "df4414693b05",
  "text": "回家問問大人：我們每天，有沒有用到 AI 呢？"
 }
]