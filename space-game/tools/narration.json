[
 {
  "key": "intro.hi",
  "id": "4e3eda562f47",
  "text": "坐小火箭，去看太陽和行星！"
 },
 {
  "key": "intro.found",
  "id": "16a655a907c5",
  "text": "每一顆星球，都有任務等你。"
 },
 {
  "key": "intro.press",
  "id": "be488d3f23d2",
  "text": "按出發，我們走吧！"
 },
 {
  "key": "w.goal",
  "id": "933d8c1d522a",
  "text": "飛到星球旁邊，點名字進去。"
 },
 {
  "key": "c1.title",
  "id": "e156b4517c0b",
  "text": "飛向一顆星星"
 },
 {
  "key": "c2.title",
  "id": "9f698712641b",
  "text": "地球繞太陽"
 },
 {
  "key": "c3.title",
  "id": "621b6a0036e5",
  "text": "白天和晚上"
 },
 {
  "key": "c4.title",
  "id": "c1bf0e4ab564",
  "text": "月亮變變變"
 },
 {
  "key": "c6.title",
  "id": "ed25125d3047",
  "text": "木星有多大"
 },
 {
  "key": "c8.title",
  "id": "cb5bc6ed7949",
  "text": "土星的環"
 },
 {
  "key": "c9.title",
  "id": "991d7922336e",
  "text": "剛剛好的地球"
 },
 {
  "key": "c10.title",
  "id": "e36432d4e9e3",
  "text": "發射去火星"
 },
 {
  "key": "n.mercury",
  "id": "2b16d7a47c73",
  "text": "水星"
 },
 {
  "key": "n.venus",
  "id": "4aa2f91c2b5c",
  "text": "金星"
 },
 {
  "key": "n.earth",
  "id": "a04d7faed1e8",
  "text": "地球"
 },
 {
  "key": "n.mars",
  "id": "79d91579056c",
  "text": "火星"
 },
 {
  "key": "n.jupiter",
  "id": "b534a49b20be",
  "text": "木星"
 },
 {
  "key": "n.saturn",
  "id": "e688913da7cb",
  "text": "土星"
 },
 {
  "key": "n.uranus",
  "id": "27e817838a22",
  "text": "天王星"
 },
 {
  "key": "n.neptune",
  "id": "085c01cbce0e",
  "text": "海王星"
 },
 {
  "key": "n.sun",
  "id": "30ee90bdba2c",
  "text": "太陽"
 },
 {
  "key": "n.moon",
  "id": "a6a01d14a2b3",
  "text": "月亮"
 },
 {
  "key": "c1.goal",
  "id": "3459fb34397c",
  "text": "按住按鈕，往前飛！"
 },
 {
  "key": "c1.mid",
  "id": "8b3270d7544f",
  "text": "星星變大了！"
 },
 {
  "key": "c1.f1",
  "id": "39b9f96cff71",
  "text": "這顆星星，就是太陽！"
 },
 {
  "key": "c1.f2",
  "id": "2fbefc5b5c77",
  "text": "天上的星星，都是很遠很遠的太陽。"
 },
 {
  "key": "c1.f3",
  "id": "9b52126a6a0f",
  "text": "眼睛不可以直接看太陽喔。"
 },
 {
  "key": "c2.goal",
  "id": "76930e950031",
  "text": "在太陽旁邊畫圓圈，帶地球走。"
 },
 {
  "key": "c2.more",
  "id": "30ffba5c81cc",
  "text": "再繞一圈！"
 },
 {
  "key": "c2.lap",
  "id": "e2602c8686f4",
  "text": "繞一圈了！"
 },
 {
  "key": "c2.f1",
  "id": "92a6d7c69b96",
  "text": "地球繞太陽一圈，就是一年。"
 },
 {
  "key": "c2.f2",
  "id": "18e9a4892793",
  "text": "你幾歲，就跟著地球繞了幾圈。"
 },
 {
  "key": "c3.goal1",
  "id": "b5fd8725522b",
  "text": "左右拖，把小房子轉到太陽那一邊。"
 },
 {
  "key": "c3.dayok",
  "id": "145869ac37fd",
  "text": "太陽照到了，是白天！"
 },
 {
  "key": "c3.goal2",
  "id": "06ca25503bd5",
  "text": "再轉到太陽照不到的那一邊。"
 },
 {
  "key": "c3.nightok",
  "id": "f69883ff6087",
  "text": "照不到太陽，是晚上。"
 },
 {
  "key": "c3.f1",
  "id": "e8ce8f637eae",
  "text": "地球自己轉一圈，就是一天。"
 },
 {
  "key": "c3.f2",
  "id": "fcd9deda6c6d",
  "text": "我們晚上睡覺時，地球另一邊是白天。"
 },
 {
  "key": "c4.goal",
  "id": "078b2e5b2910",
  "text": "拖一拖月亮，變成框框裡的樣子。"
 },
 {
  "key": "c4.ok",
  "id": "d7fba273955c",
  "text": "對了！"
 },
 {
  "key": "c4.next",
  "id": "2c38d39f53fe",
  "text": "再變一個樣子！"
 },
 {
  "key": "c4.f1",
  "id": "b8aa979273f9",
  "text": "月亮不會發光，是太陽照亮的。"
 },
 {
  "key": "c4.f2",
  "id": "ace351574f80",
  "text": "亮的那一面，看到多或少，月亮就變樣子。"
 },
 {
  "key": "c4.f3",
  "id": "51809d93dd7c",
  "text": "月亮繞地球一圈，大約一個月。"
 },
 {
  "key": "c6.goal",
  "id": "c04e0ace182d",
  "text": "按放地球，一顆一顆排滿木星。"
 },
 {
  "key": "c6.f1",
  "id": "b248f7590898",
  "text": "木星，要排十一個地球！"
 },
 {
  "key": "c6.zoom",
  "id": "dfa3a914ca03",
  "text": "往後退，看看太陽……"
 },
 {
  "key": "c6.f2",
  "id": "57ad2876eaf8",
  "text": "太陽更大！要排一百多個地球。"
 },
 {
  "key": "c8.goal1",
  "id": "259c148e65a3",
  "text": "往上滑一滑，飛近一點看。"
 },
 {
  "key": "c8.near",
  "id": "914c4afa9e77",
  "text": "環散開了？"
 },
 {
  "key": "c8.f1",
  "id": "05ba2d58677e",
  "text": "土星的環，是好多冰塊和石頭在繞圈。"
 },
 {
  "key": "c8.goal2",
  "id": "8f6d41d86887",
  "text": "左右拖一拖，從側面看看。"
 },
 {
  "key": "c8.f2",
  "id": "179699e42ad7",
  "text": "從側面看，環幾乎不見了，因為它好薄好薄。"
 },
 {
  "key": "c9.goal1",
  "id": "f2719061b7e4",
  "text": "把地球拖到太陽旁邊。"
 },
 {
  "key": "c9.hotok",
  "id": "3267617ab7f5",
  "text": "好燙！水都變成水蒸氣，飛走了。"
 },
 {
  "key": "c9.goal2",
  "id": "2b567f358591",
  "text": "再拖到離太陽很遠的地方。"
 },
 {
  "key": "c9.coldok",
  "id": "af71662e0dc9",
  "text": "好冷！水都結成冰了。"
 },
 {
  "key": "c9.goal3",
  "id": "6d5bb57c0382",
  "text": "把地球拖回剛剛好的地方。"
 },
 {
  "key": "c9.f1",
  "id": "e5171b35b2f0",
  "text": "不熱也不冷，水可以流來流去。"
 },
 {
  "key": "c9.f2",
  "id": "683e89603b1e",
  "text": "有水、有空氣，生物才能住在地球上。"
 },
 {
  "key": "c10.goal",
  "id": "1dfe65fe7b52",
  "text": "火星走進金色框框時，按發射！"
 },
 {
  "key": "c10.fly",
  "id": "842311529802",
  "text": "飛呀飛……"
 },
 {
  "key": "c10.miss",
  "id": "7497c9d3e13b",
  "text": "火星跑走了！等它走進框框，再試一次。"
 },
 {
  "key": "c10.f1",
  "id": "98f55d5ff3b6",
  "text": "接到了！火箭把探測車送到火星了。"
 },
 {
  "key": "c10.f2",
  "id": "6aa4ee781e31",
  "text": "火星一直在動，要瞄準它等一下會到的地方。"
 },
 {
  "key": "p.mercury",
  "id": "96fe8571eee3",
  "text": "離太陽最近，最小。"
 },
 {
  "key": "p.venus",
  "id": "00073828b8b5",
  "text": "最熱！厚厚的雲，熱氣跑不出去。"
 },
 {
  "key": "p.earth",
  "id": "8cd6c7431cca",
  "text": "我們的家，有水、有空氣。"
 },
 {
  "key": "p.mars",
  "id": "455fa5dd8957",
  "text": "紅紅的，因為土裡有鐵鏽。"
 },
 {
  "key": "p.jupiter",
  "id": "f81f036853c9",
  "text": "最大！紅色斑點是一個大風暴。"
 },
 {
  "key": "p.saturn",
  "id": "49eb4333c0f9",
  "text": "有一圈漂亮的環。"
 },
 {
  "key": "p.uranus",
  "id": "db93cf16046a",
  "text": "躺著轉圈圈。"
 },
 {
  "key": "p.neptune",
  "id": "b530457c23cd",
  "text": "離太陽最遠，又冷又藍，風好大。"
 },
 {
  "key": "v.land",
  "id": "a7489065dd3c",
  "text": "把太空船拖到星球上，看能不能降落。"
 },
 {
  "key": "c7.land",
  "id": "236f19e0c9d2",
  "text": "降落了！地面硬硬的。"
 },
 {
  "key": "c7.sink",
  "id": "29826a0d956b",
  "text": "咦？一直往下沉，沒有地面！"
 },
 {
  "key": "v.rock",
  "id": "97b00c5e0bb3",
  "text": "它是岩石行星，有硬硬的地面，可以站上去。"
 },
 {
  "key": "v.gas",
  "id": "cbf1938a1008",
  "text": "它是大大的氣體行星，沒有地面。"
 },
 {
  "key": "fin.title",
  "id": "4717c92e9be9",
  "text": "太空小探險家"
 },
 {
  "key": "fin.hi",
  "id": "e32a42567839",
  "text": "你完成了全部的太空任務！"
 },
 {
  "key": "fin.task",
  "id": "47695eaebbae",
  "text": "今天晚上，和家人看看月亮，它是什麼樣子？"
 }
]