[
 {
  "key": "g.no1",
  "id": "3b6253c40a96",
  "text": "再試試看喔。"
 },
 {
  "key": "g.no2",
  "id": "d1268e26f792",
  "text": "不要緊，再想一想。"
 },
 {
  "key": "intro.hi",
  "id": "823e77c307b0",
  "text": "你好！你聽過頌缽的聲音嗎？"
 },
 {
  "key": "intro.found",
  "id": "3e3309183576",
  "text": "頌缽是一個會唱歌的金屬碗。我們一起去工坊，做一個頌缽！"
 },
 {
  "key": "intro.press",
  "id": "054c4d2ead3a",
  "text": "按鍵盤上的 S，我們出發！"
 },
 {
  "key": "c1.title",
  "id": "1b46808d9e0f",
  "text": "第一關，聽頌缽唱歌"
 },
 {
  "key": "c2.title",
  "id": "74ca11de347f",
  "text": "第二關，缽這個字"
 },
 {
  "key": "c3.title",
  "id": "7d1ba9f5f970",
  "text": "第三關，找金屬"
 },
 {
  "key": "c4.title",
  "id": "9930ce6437cf",
  "text": "第四關，調配方"
 },
 {
  "key": "c5.title",
  "id": "035071568273",
  "text": "第五關，生火"
 },
 {
  "key": "c6.title",
  "id": "ab3015da4564",
  "text": "第六關，倒進模子"
 },
 {
  "key": "c7.title",
  "id": "ffc1c6f33b31",
  "text": "第七關，趁熱敲打"
 },
 {
  "key": "c8.title",
  "id": "6e3eb6183ad3",
  "text": "第八關，泡冷水"
 },
 {
  "key": "c9.title",
  "id": "6f837058f642",
  "text": "第九關，磨亮亮"
 },
 {
  "key": "c10.title",
  "id": "f4e46d467712",
  "text": "第十關，大缽小缽"
 },
 {
  "key": "c1.hit",
  "id": "a5eca5502471",
  "text": "先輕輕敲一下頌缽。點一點頌缽，或按 D。"
 },
 {
  "key": "c1.hitok",
  "id": "413fa3f1eff8",
  "text": "噹——聲音好長，慢慢才消失。"
 },
 {
  "key": "c1.rub",
  "id": "1d4bd9800df5",
  "text": "頌缽還有另一種玩法：用木棒繞著邊邊，一圈一圈磨。用手指或滑鼠，繞著缽畫圓圈。"
 },
 {
  "key": "c1.sing",
  "id": "1c94b8a7ab88",
  "text": "聽！頌缽唱歌了！"
 },
 {
  "key": "c1.why",
  "id": "1c39ce0fc4ab",
  "text": "敲它或磨它，頌缽就會很快很快抖動。抖動讓空氣也跟著抖，傳到耳朵裡，就變成聲音。"
 },
 {
  "key": "c1.done",
  "id": "504fe3dd3287",
  "text": "這麼會唱歌的碗，是怎麼做出來的呢？我們一步一步來做。"
 },
 {
  "key": "c2.intro",
  "id": "1f25d633366b",
  "text": "頌缽的缽，是一個很老的字。我們來拼拼看。"
 },
 {
  "key": "c2.how",
  "id": "d1a45de78ffe",
  "text": "把左邊和右邊，拖進格子裡。"
 },
 {
  "key": "c2.fou",
  "id": "13b1e7b8d07d",
  "text": "左邊是缶，古時候用陶土做的罐子。"
 },
 {
  "key": "c2.ben",
  "id": "b691ef0b2589",
  "text": "右邊是本，它跟缽的聲音有一點像。"
 },
 {
  "key": "c2.made",
  "id": "575d8e872b4d",
  "text": "合起來，就是缽：一種開口大大的碗。"
 },
 {
  "key": "c2.metal",
  "id": "5b21e5e66e55",
  "text": "缽還有另一種寫法，左邊換成金字旁。因為很多缽，是用金屬做的。"
 },
 {
  "key": "c2.q",
  "id": "55e987038efb",
  "text": "頌缽是用什麼做的？"
 },
 {
  "key": "c2.ok",
  "id": "6115356af9c3",
  "text": "對！頌缽是金屬做的，所以敲起來會噹噹響。"
 },
 {
  "key": "c3.intro",
  "id": "b655f893e344",
  "text": "頌缽主要用兩種金屬：銅和錫。它們藏在山裡的石頭中。"
 },
 {
  "key": "c3.how",
  "id": "592d2cbda192",
  "text": "點石頭，把它敲開！一直點，或一直按 K。"
 },
 {
  "key": "c3.plain",
  "id": "560005a1d05b",
  "text": "這一顆，只是普通的石頭。再敲別顆。"
 },
 {
  "key": "c3.cu",
  "id": "f031717fa6c2",
  "text": "找到銅礦了！綠綠的礦石，燒一燒，就能取出紅紅的銅。"
 },
 {
  "key": "c3.sn",
  "id": "33ed6f3b42fb",
  "text": "找到錫礦了！黑黑的礦石，燒一燒，就能取出銀白色的錫。"
 },
 {
  "key": "c3.done",
  "id": "4809554ce9c5",
  "text": "工人把礦石放進火裡燒，就能取出銅和錫。"
 },
 {
  "key": "c4.intro",
  "id": "5cbef2aeb30a",
  "text": "做頌缽的金屬，叫做青銅。它是銅和錫混在一起。"
 },
 {
  "key": "c4.how",
  "id": "e4a0c55bfc82",
  "text": "配方是：四塊銅，加一塊錫。把它們拖進鍋子裡。"
 },
 {
  "key": "c4.toomuchsn",
  "id": "faba6a716504",
  "text": "錫太多了！缽會太脆，一敲就裂開。一塊錫就夠了。"
 },
 {
  "key": "c4.toomuchcu",
  "id": "db01c9796ed1",
  "text": "銅已經有四塊，夠了喔。"
 },
 {
  "key": "c4.done",
  "id": "a9a833b8cce5",
  "text": "四塊銅加一塊錫，剛剛好！這樣的青銅，又硬又響亮。"
 },
 {
  "key": "c5.intro",
  "id": "d9fe0a0dc4d2",
  "text": "把鍋子放進火爐。金屬要非常非常熱，才會融化，變得像水一樣。"
 },
 {
  "key": "c5.how",
  "id": "b44e55f769f6",
  "text": "用風箱幫火吹氣！上下拉風箱，或輪流按 W 和 S。"
 },
 {
  "key": "c5.red",
  "id": "9a25e0f188a9",
  "text": "火越來越旺，鍋子變紅了！繼續吹！"
 },
 {
  "key": "c5.melt",
  "id": "9405583389f9",
  "text": "融化了！這時候的火，比家裡的烤箱還要熱好幾倍。"
 },
 {
  "key": "c6.intro",
  "id": "41f57e449390",
  "text": "把融化的青銅，倒進圓圓的模子裡，做成一塊金屬餅。"
 },
 {
  "key": "c6.how",
  "id": "76ab6ea86c45",
  "text": "按住按鈕，或按住空白鍵，慢慢倒。到了金色的線，就放開！"
 },
 {
  "key": "c6.over",
  "id": "6d664f85d52e",
  "text": "倒太多，溢出來了！沒關係，再試一次。"
 },
 {
  "key": "c6.less",
  "id": "5f5adeec1b95",
  "text": "還不夠滿，再倒一點點。"
 },
 {
  "key": "c6.ok",
  "id": "7dab9f768eb0",
  "text": "剛剛好！"
 },
 {
  "key": "c6.again",
  "id": "a1db899777b4",
  "text": "再做一塊，給下一個頌缽。"
 },
 {
  "key": "c6.done",
  "id": "ca688669c809",
  "text": "金屬餅冷了，變硬了。頌缽一開始，就是這樣一塊厚厚的圓餅。"
 },
 {
  "key": "c7.intro",
  "id": "12c4fdb7fb89",
  "text": "把金屬餅燒紅。燒紅的青銅比較軟，才敲得動。"
 },
 {
  "key": "c7.team",
  "id": "fa65e09bc1b0",
  "text": "在尼泊爾，常常有好幾個師傅圍成一圈，輪流敲。叮、噹、叮，換你！"
 },
 {
  "key": "c7.how",
  "id": "281d44c346a0",
  "text": "亮到你的槌子的時候，按空白鍵，或點一下金屬餅。"
 },
 {
  "key": "c7.miss",
  "id": "0cf87011eb8f",
  "text": "等亮到你的時候再敲喔。"
 },
 {
  "key": "c7.cool",
  "id": "8fb2717c8d24",
  "text": "金屬變冷、變暗了。冷的時候敲，它會裂開。把它拖回火裡，再燒紅。"
 },
 {
  "key": "c7.hot",
  "id": "38768759ede7",
  "text": "又紅了，繼續敲！"
 },
 {
  "key": "c7.shape",
  "id": "2b0f6189aee8",
  "text": "你看，平平的餅，慢慢變成碗的樣子了！"
 },
 {
  "key": "c7.done",
  "id": "a2006f0afa29",
  "text": "師傅們要燒很多次、敲好幾千下，才能敲出一個頌缽。"
 },
 {
  "key": "c8.intro",
  "id": "f61e2209fd0e",
  "text": "形狀敲好了。最後一次，把缽燒得紅紅的。"
 },
 {
  "key": "c8.how",
  "id": "fe9544dd8d47",
  "text": "把缽拖進火裡，等它變紅，再拖進水桶。"
 },
 {
  "key": "c8.wait",
  "id": "cc10270127b3",
  "text": "等它燒紅，再拿出來。"
 },
 {
  "key": "c8.notyet",
  "id": "c8de389eece6",
  "text": "還不夠紅喔，再燒一下。"
 },
 {
  "key": "c8.zz",
  "id": "d4e409772bec",
  "text": "滋——！好多白煙！"
 },
 {
  "key": "c8.why",
  "id": "389ab0124cf6",
  "text": "燒紅了，馬上泡進冷水，青銅就比較不容易裂開。這是做頌缽的祕密之一。"
 },
 {
  "key": "c9.intro",
  "id": "b69da40f14e0",
  "text": "剛泡完水的缽，黑黑的。"
 },
 {
  "key": "c9.how",
  "id": "afe87d11c516",
  "text": "幫它磨亮！用手指或滑鼠，在缽上來回擦一擦。"
 },
 {
  "key": "c9.half",
  "id": "4b93a967e408",
  "text": "亮起來了，繼續擦！"
 },
 {
  "key": "c9.done",
  "id": "6c0e3585db75",
  "text": "金金亮亮的！有的師傅會留下敲打的痕跡，有的會把它磨得很光滑。"
 },
 {
  "key": "c10.intro",
  "id": "70bb2f88c9a7",
  "text": "頌缽有大有小。點一點，聽聽看，它們的聲音有什麼不一樣？"
 },
 {
  "key": "c10.q",
  "id": "766fd81d74cb",
  "text": "哪一個缽的聲音最低？"
 },
 {
  "key": "c10.ok",
  "id": "71ebfe91f00c",
  "text": "對！大的缽，聲音比較低；小的缽，聲音比較高。"
 },
 {
  "key": "c10.water",
  "id": "261e0c766a9d",
  "text": "在缽裡倒一點水，再磨磨看。把水壺拖到缽上。"
 },
 {
  "key": "c10.rub",
  "id": "4bf58d019d93",
  "text": "繞著缽畫圓圈，看看水會怎麼樣？"
 },
 {
  "key": "c10.dance",
  "id": "eb612a05d388",
  "text": "水在跳舞！因為缽在很快很快抖動，抖動傳給了水。"
 },
 {
  "key": "c10.low",
  "id": "d2882f4448fb",
  "text": "有水的時候，聲音也變得低一點。"
 },
 {
  "key": "c10.done",
  "id": "144adc7fa3a5",
  "text": "你一步一步，做出了一個會唱歌的頌缽！"
 },
 {
  "key": "fin.hi",
  "id": "cff1fcbf57f3",
  "text": "你好厲害！你是頌缽小師傅！"
 },
 {
  "key": "fin.task",
  "id": "64234efe7e8c",
  "text": "回家找一找，家裡有哪些東西，敲起來也會唱歌？"
 }
]