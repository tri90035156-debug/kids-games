[
 {
  "key": "g.no1",
  "id": "9f92bda94f2a",
  "text": "再試試看。"
 },
 {
  "key": "g.no2",
  "id": "ab16d08b9f0b",
  "text": "沒關係，看看亮亮的那一張。"
 },
 {
  "key": "g.good",
  "id": "d7fba273955c",
  "text": "對了！"
 },
 {
  "key": "g.next",
  "id": "fd1bb5036514",
  "text": "點亮亮的地方，繼續。"
 },
 {
  "key": "g.match",
  "id": "f554c8e0d172",
  "text": "把左邊的卡片，連到右邊對的卡片。"
 },
 {
  "key": "g.order",
  "id": "25dceb0cd85b",
  "text": "照順序，一張一張點。先做的先點。"
 },
 {
  "key": "g.pick",
  "id": "890ee7759d1b",
  "text": "你覺得是哪一個？"
 },
 {
  "key": "intro.1",
  "id": "4fb982d8998c",
  "text": "你抱著的小熊玩偶，軟軟的，是從哪裡來的呢？"
 },
 {
  "key": "intro.2",
  "id": "8be0b02b842e",
  "text": "它走了好長的一段路，才到你的手上。我們一站一站去看。"
 },
 {
  "key": "ch1",
  "id": "40e7e5c2accb",
  "text": "第一站，原料哪裡來？"
 },
 {
  "key": "l1.q",
  "id": "82053f1beb27",
  "text": "玩偶是用三種材料做的。每一種材料，是從哪裡來的？連連看。"
 },
 {
  "key": "l1.cotton",
  "id": "a98977a83708",
  "text": "棉花，是棉花田裡的植物長出來的，白白的一團。"
 },
 {
  "key": "l1.wool",
  "id": "014de3c46465",
  "text": "羊毛，是從綿羊身上剪下來的，暖暖的。"
 },
 {
  "key": "l1.oil",
  "id": "71763b4af555",
  "text": "石油，是從地底下抽出來的黑色的油。玩偶身上最多的材料，就是石油做的！"
 },
 {
  "key": "l1.done",
  "id": "a1ba38ea214f",
  "text": "原來材料有的從田裡來，有的從羊身上來，有的從地底下來。"
 },
 {
  "key": "l2.q",
  "id": "4e4f4bfc64a8",
  "text": "黑黑的石油，怎麼變成軟軟的絨布？照順序點。"
 },
 {
  "key": "l2.s1",
  "id": "bb2b55d46cab",
  "text": "第一步，把石油從地底下抽上來。"
 },
 {
  "key": "l2.s2",
  "id": "16b29642e628",
  "text": "第二步，化學工廠把石油變成小小的塑膠顆粒。"
 },
 {
  "key": "l2.s3",
  "id": "fc86afdcbed9",
  "text": "第三步，把顆粒加熱融化，拉成比頭髮還細的絲，叫做聚酯纖維。"
 },
 {
  "key": "l2.s4",
  "id": "6300d4e6d081",
  "text": "第四步，把好多好多的絲織在一起，變成毛毛的絨布。"
 },
 {
  "key": "l2.s5",
  "id": "b776533898c1",
  "text": "第五步，把絨布染成喜歡的顏色。"
 },
 {
  "key": "l2.done",
  "id": "c2c5c5b41e64",
  "text": "石油變顆粒，顆粒變細絲，細絲織成布。摸摸看，絨布毛毛的！"
 },
 {
  "key": "l3.q",
  "id": "35408a80c249",
  "text": "玩偶身上有四個部分。每一個部分，是用什麼做的？連連看。"
 },
 {
  "key": "l3.fur",
  "id": "2ca7e101d8e9",
  "text": "外面毛毛的皮，是絨布，用聚酯纖維織的。"
 },
 {
  "key": "l3.fill",
  "id": "311d68497782",
  "text": "裡面軟軟的，是填充棉，也是聚酯纖維，蓬蓬的。"
 },
 {
  "key": "l3.eye",
  "id": "ca0236498b34",
  "text": "眼睛，是硬硬的塑膠做的，叫安全眼，後面有扣子，扣住就拉不掉。"
 },
 {
  "key": "l3.thread",
  "id": "d541de973c24",
  "text": "縫線，是很細很強的線，把每一塊布縫在一起。"
 },
 {
  "key": "l3.done",
  "id": "6e3644dbd698",
  "text": "絨布、填充棉、安全眼、縫線，四種材料準備好了，送去工廠！"
 },
 {
  "key": "ch2",
  "id": "aa40e74fefa2",
  "text": "第二站，工廠怎麼把它組裝起來？"
 },
 {
  "key": "l4.q",
  "id": "9b08ac87b917",
  "text": "材料到了工廠。做玩偶之前，要先做什麼？"
 },
 {
  "key": "l4.a",
  "id": "2cf7decedbb5",
  "text": "先畫設計圖，再做紙型。"
 },
 {
  "key": "l4.b",
  "id": "219535be6fc0",
  "text": "先把棉花塞進去。"
 },
 {
  "key": "l4.c",
  "id": "20e137651f67",
  "text": "先裝眼睛。"
 },
 {
  "key": "l4.yes",
  "id": "92e57e97998b",
  "text": "對！設計師先畫出小熊的樣子，再把每一塊布畫成紙型。有了紙型，每一隻小熊才會長得一樣。"
 },
 {
  "key": "l4.no",
  "id": "7780cb8313bf",
  "text": "還沒有布的形狀，不能塞棉花、也不能裝眼睛喔。要先畫圖。"
 },
 {
  "key": "l5.q",
  "id": "297fa3ab5cf4",
  "text": "工廠裡的每一步，照順序點。"
 },
 {
  "key": "l5.s1",
  "id": "62a843f6fe05",
  "text": "裁布。用紙型做的刀模，一次壓下去，壓出好幾十片一樣的布。"
 },
 {
  "key": "l5.s2",
  "id": "5f65c1605e16",
  "text": "裝眼睛。把安全眼從布的正面插進去，後面扣上扣子。"
 },
 {
  "key": "l5.s3",
  "id": "4481160ecab9",
  "text": "縫合。縫紉機把布反過來縫，毛毛的那一面在裡面。"
 },
 {
  "key": "l5.s4",
  "id": "9395c2171537",
  "text": "翻面。從留的小洞，把整隻小熊翻過來，毛毛的一面跑到外面。"
 },
 {
  "key": "l5.s5",
  "id": "4324bd0b4198",
  "text": "塞棉花。填充機把填充棉吹進去，小熊變得胖胖的。"
 },
 {
  "key": "l5.s6",
  "id": "f8fd5c9dc406",
  "text": "縫上最後的小洞。工人用手一針一針縫，看不出來在哪裡。"
 },
 {
  "key": "l5.done",
  "id": "15ec6b5da812",
  "text": "裁布、裝眼睛、縫合、翻面、塞棉花、縫口。一隻小熊就做好了！"
 },
 {
  "key": "l6.q",
  "id": "c22f03164413",
  "text": "換你來塞棉花！按住不放，填充機就會把棉花吹進去。吹到剛剛好。"
 },
 {
  "key": "l6.more",
  "id": "34663c483a5c",
  "text": "還扁扁的，再按住一下。"
 },
 {
  "key": "l6.ok",
  "id": "81666adf12fd",
  "text": "剛剛好！抱起來軟軟的，又不會太硬。"
 },
 {
  "key": "l6.over",
  "id": "c2ecdccacbd8",
  "text": "太多了！硬邦邦的，不好抱。放掉一點。"
 },
 {
  "key": "l7.q",
  "id": "378881791a97",
  "text": "做好了小熊，為什麼要經過金屬探測器？"
 },
 {
  "key": "l7.a",
  "id": "85b0d376f288",
  "text": "看看裡面有沒有掉進去的斷針。"
 },
 {
  "key": "l7.b",
  "id": "911f0fe6c560",
  "text": "量它有多重。"
 },
 {
  "key": "l7.c",
  "id": "739cfa7e97f9",
  "text": "幫它取名字。"
 },
 {
  "key": "l7.yes",
  "id": "8dc31f7b47f3",
  "text": "對！縫的時候，針可能會斷掉、掉進棉花裡。探測器一嗶，就要把那隻拆開找出來。還要用力拉拉眼睛，確定拉不掉。"
 },
 {
  "key": "l7.no",
  "id": "7163f770d7a1",
  "text": "探測器找的是金屬，像針那樣的東西。再想想看。"
 },
 {
  "key": "l7.done",
  "id": "fb8fae9ad8ce",
  "text": "檢查都通過，小熊才能裝進袋子，準備出發。"
 },
 {
  "key": "ch3",
  "id": "f41626facef5",
  "text": "第三站，做好的小熊，怎麼到你的手上？"
 },
 {
  "key": "l8.q",
  "id": "8e06e53efe9c",
  "text": "工廠在很遠的國家。小熊要坐什麼來？照順序點。"
 },
 {
  "key": "l8.s1",
  "id": "68bd1f61fbf7",
  "text": "裝箱。很多隻小熊裝進一個紙箱。"
 },
 {
  "key": "l8.s2",
  "id": "e96be949611e",
  "text": "裝進貨櫃。好幾百個紙箱，放進一個像大鐵盒的貨櫃。"
 },
 {
  "key": "l8.s3",
  "id": "d6495a831d7b",
  "text": "卡車把貨櫃載到港口，大吊車把貨櫃吊上船。"
 },
 {
  "key": "l8.s4",
  "id": "108075b1ade9",
  "text": "貨櫃船載著好幾千個貨櫃，開過大海，要開好多天。"
 },
 {
  "key": "l8.s5",
  "id": "f27b8a25770b",
  "text": "到了我們的港口，海關檢查過，才可以進來。"
 },
 {
  "key": "l8.s6",
  "id": "3cca302fabfd",
  "text": "卡車把貨櫃載到倉庫，再把小熊一箱一箱送到商店。"
 },
 {
  "key": "l8.done",
  "id": "0399bdf812e2",
  "text": "箱子、貨櫃、卡車、大船、港口、商店，小熊坐了好多種車和船！"
 },
 {
  "key": "l9.q",
  "id": "ef2df347f393",
  "text": "這麼多人一起幫忙，誰做了什麼事？連連看。"
 },
 {
  "key": "l9.factory",
  "id": "945a0e7e2df4",
  "text": "工廠，把小熊做出來。"
 },
 {
  "key": "l9.ship",
  "id": "1b477f5100f9",
  "text": "船公司，把貨櫃運過大海。"
 },
 {
  "key": "l9.customs",
  "id": "74c755444d04",
  "text": "海關，檢查進來的東西安不安全。"
 },
 {
  "key": "l9.shop",
  "id": "df905e438e21",
  "text": "商店，把小熊放在架子上賣。"
 },
 {
  "key": "l9.parent",
  "id": "0ff79376bd65",
  "text": "爸爸媽媽，用錢把小熊買回家。"
 },
 {
  "key": "l9.trade",
  "id": "f52241c09840",
  "text": "工廠在別的國家，我們給他們錢，他們給我們小熊。這樣交換，就叫做貿易。"
 },
 {
  "key": "l10.q",
  "id": "56b2b715ca0a",
  "text": "最後，把小熊的整趟旅行，從頭到尾排一次。"
 },
 {
  "key": "l10.s1",
  "id": "9e8807b9619a",
  "text": "石油、棉花，從地底和田裡來。"
 },
 {
  "key": "l10.s2",
  "id": "5e3767fbbb4b",
  "text": "變成絨布和填充棉。"
 },
 {
  "key": "l10.s3",
  "id": "ac0dd1f171ab",
  "text": "工廠裁布、縫合、塞棉花、檢查。"
 },
 {
  "key": "l10.s4",
  "id": "2650c284d786",
  "text": "裝進貨櫃，坐船過大海。"
 },
 {
  "key": "l10.s5",
  "id": "aa4fc14fc53f",
  "text": "海關檢查，送到商店。"
 },
 {
  "key": "l10.s6",
  "id": "0887db1bda5e",
  "text": "爸爸媽媽買回家，到你的手上。"
 },
 {
  "key": "end.1",
  "id": "62a9006a5559",
  "text": "一隻小小的玩偶，要經過好多好多人的手。"
 },
 {
  "key": "end.2",
  "id": "89195e37f9fa",
  "text": "從地底下和田裡的材料，到工廠的工人，到船上的水手，到商店的老闆。"
 },
 {
  "key": "end.3",
  "id": "f273f1b3acd8",
  "text": "所以，要好好愛惜你的玩偶喔。下次抱它的時候，想想它走過的這一趟旅行。"
 },
 {
  "key": "end.again",
  "id": "96b16907265a",
  "text": "想再看一次，就點任何一站。"
 },
