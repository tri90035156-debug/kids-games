[
 {
  "key": "g.no1",
  "id": "9f92bda94f2a",
  "text": "再試試看。"
 },
 {
  "key": "g.no2",
  "id": "73728d51989c",
  "text": "沒關係，看看亮亮的地方。"
 },
 {
  "key": "intro.hi",
  "id": "384ff0905ce8",
  "text": "你的身體裡面，藏著好多會動的東西！"
 },
 {
  "key": "intro.found",
  "id": "69b8cd37e40a",
  "text": "我們打開小人身上的門，一個一個去看。"
 },
 {
  "key": "intro.press",
  "id": "be488d3f23d2",
  "text": "按出發，我們走吧！"
 },
 {
  "key": "c1.title",
  "id": "c222b2307977",
  "text": "嘴巴，咬一咬"
 },
 {
  "key": "c1.s1",
  "id": "9af83ccffd9a",
  "text": "一口飯，從嘴巴開始旅行。"
 },
 {
  "key": "c1.s2",
  "id": "d3a1db29a20f",
  "text": "牙齒是小小的剪刀和磨石，把食物咬碎。"
 },
 {
  "key": "c1.task",
  "id": "91b72d7c70fb",
  "text": "一直點牙齒，咬一咬！"
 },
 {
  "key": "c1.mid",
  "id": "e2b3fe2fa302",
  "text": "口水跑出來了，飯變得軟軟的。"
 },
 {
  "key": "c1.end",
  "id": "325b6ec865ec",
  "text": "牙齒把食物咬碎，口水讓它軟軟滑滑，比較好吞。"
 },
 {
  "key": "c2.title",
  "id": "4ec2665fe3d2",
  "text": "食道，往下擠"
 },
 {
  "key": "c2.s1",
  "id": "744661d9ae5e",
  "text": "吞下去以後，飯走進一條長長的管子，叫做食道。"
 },
 {
  "key": "c2.s2",
  "id": "7795f1e6bb5d",
  "text": "食道會一段一段擠，像擠牙膏一樣。"
 },
 {
  "key": "c2.task",
  "id": "268fc2b8379b",
  "text": "用手指沿著食道往下拖，把飯擠下去。"
 },
 {
  "key": "c2.mid",
  "id": "611c66d146e6",
  "text": "擠到哪裡，哪裡就縮緊。"
 },
 {
  "key": "c2.end",
  "id": "5560f4922249",
  "text": "食道會一段一段擠，所以躺著也吞得下去。"
 },
 {
  "key": "c3.title",
  "id": "dc93b8d3a8ae",
  "text": "胃，攪一攪"
 },
 {
  "key": "c3.s1",
  "id": "70417960c061",
  "text": "飯掉進胃裡了。胃像一個會動的袋子。"
 },
 {
  "key": "c3.task",
  "id": "db85360a49b2",
  "text": "按住按鈕，讓胃動起來。"
 },
 {
  "key": "c3.mid",
  "id": "2e77587b05d8",
  "text": "胃一縮一放，把飯菜攪在一起。"
 },
 {
  "key": "c3.end",
  "id": "b9265684c267",
  "text": "胃像攪拌機，把食物攪成糊糊的，再慢慢送去小腸。"
 },
 {
  "key": "c4.title",
  "id": "8dc43bfb6a54",
  "text": "小腸，吸收好東西"
 },
 {
  "key": "c4.s1",
  "id": "2ab99725b840",
  "text": "小腸好長好長，彎來彎去塞在肚子裡。"
 },
 {
  "key": "c4.s2",
  "id": "e90b5fb81ab4",
  "text": "它把食物裡的好東西，吸進血液裡。"
 },
 {
  "key": "c4.task",
  "id": "48474e9f9526",
  "text": "連連看：這些食物，會給身體什麼？"
 },
 {
  "key": "c4.rice",
  "id": "aeb54fb76cad",
  "text": "飯和麵，給你力氣跑跑跳跳。"
 },
 {
  "key": "c4.egg",
  "id": "5a0bf2522b7a",
  "text": "蛋和肉，幫你長肌肉、長高。"
 },
 {
  "key": "c4.veg",
  "id": "c52ccdf377f5",
  "text": "青菜，幫你的肚子順順的。"
 },
 {
  "key": "c4.end",
  "id": "3f7b7cc66b38",
  "text": "小腸把好東西吸進血液，送到全身。"
 },
 {
  "key": "c5.title",
  "id": "bebb11fb377e",
  "text": "一口飯的旅行"
 },
 {
  "key": "c5.s1",
  "id": "72a34cb32986",
  "text": "最後一站是大腸。我們先把一口飯的旅行，從頭排一次。"
 },
 {
  "key": "c5.task",
  "id": "05557993e39a",
  "text": "照順序點：一口飯先到哪裡，再到哪裡？"
 },
 {
  "key": "c5.n1",
  "id": "d3fa1353ca9c",
  "text": "嘴巴，咬碎。"
 },
 {
  "key": "c5.n2",
  "id": "c52164dbac30",
  "text": "食道，往下擠。"
 },
 {
  "key": "c5.n3",
  "id": "14e1450a8d5c",
  "text": "胃，攪成糊糊的。"
 },
 {
  "key": "c5.n4",
  "id": "e5ea84bedbf3",
  "text": "小腸，吸收好東西。"
 },
 {
  "key": "c5.n5",
  "id": "6d3c67e9942e",
  "text": "大腸，把水分吸回身體。"
 },
 {
  "key": "c5.end",
  "id": "e8a27769538b",
  "text": "剩下的變成便便。多喝水、多吃青菜，便便才會順。"
 },
 {
  "key": "c6.title",
  "id": "067bd32b5950",
  "text": "心臟，像幫浦"
 },
 {
  "key": "c6.s1",
  "id": "1d68890b25e7",
  "text": "把手放在胸口，咚咚咚，那是心臟在跳。"
 },
 {
  "key": "c6.s2",
  "id": "58b43a7f8b65",
  "text": "心臟大約和你的拳頭一樣大。"
 },
 {
  "key": "c6.task",
  "id": "55eb3bad899f",
  "text": "跟著咚咚的聲音，壓一下心臟。"
 },
 {
  "key": "c6.mid",
  "id": "2dfc5c5e7139",
  "text": "血跑遍全身，把好東西送出去。"
 },
 {
  "key": "c6.run",
  "id": "d587c81e429e",
  "text": "小人去跑步了！心臟要跳快一點，快快壓！"
 },
 {
  "key": "c6.end",
  "id": "87476b56b5c9",
  "text": "心臟像幫浦，一直把血送到全身。跑步的時候，它跳得更快。"
 },
 {
  "key": "c7.title",
  "id": "22be6637f3f2",
  "text": "肺，像氣球"
 },
 {
  "key": "c7.s1",
  "id": "a5f6d60446a4",
  "text": "胸口裡面，有兩個軟軟的肺。"
 },
 {
  "key": "c7.task",
  "id": "7ebb2e535cbd",
  "text": "按住按鈕吸氣，放開吐氣，做三次。"
 },
 {
  "key": "c7.in",
  "id": "66e9edb9057b",
  "text": "吸氣，肺鼓起來了！"
 },
 {
  "key": "c7.out",
  "id": "0aeb357cb094",
  "text": "吐氣，肺變小了。"
 },
 {
  "key": "c7.end",
  "id": "b1dc62950439",
  "text": "吸氣時，肺把氧氣交給血液；吐氣時，把用過的空氣送出去。"
 },
 {
  "key": "c8.title",
  "id": "7aff9e1f5149",
  "text": "骨頭，撐住身體"
 },
 {
  "key": "c8.s1",
  "id": "d561dba114b9",
  "text": "摸摸你的手和腳，硬硬的是骨頭。"
 },
 {
  "key": "c8.task",
  "id": "7144624dced3",
  "text": "連連看：每塊骨頭，在幫什麼忙？"
 },
 {
  "key": "c8.skull",
  "id": "d7c8f25420a7",
  "text": "頭骨像安全帽，保護頭腦。"
 },
 {
  "key": "c8.ribs",
  "id": "43edba7d1260",
  "text": "肋骨像籠子，保護心臟和肺。"
 },
 {
  "key": "c8.leg",
  "id": "0e2dcf8124fc",
  "text": "腿骨像柱子，撐住身體走路。"
 },
 {
  "key": "c8.end",
  "id": "09f46a8c62a3",
  "text": "骨頭撐住身體，也保護軟軟的器官。大人身上有兩百多塊骨頭。"
 },
 {
  "key": "c9.title",
  "id": "122ad19c88ad",
  "text": "肌肉，拉骨頭"
 },
 {
  "key": "c9.s1",
  "id": "311ddf4ffbcd",
  "text": "骨頭自己不會動，要靠肌肉來拉。"
 },
 {
  "key": "c9.task",
  "id": "790eb300745c",
  "text": "把小人的手往上拉，彎起來。"
 },
 {
  "key": "c9.mid",
  "id": "f19978a0f43e",
  "text": "前面的肌肉縮短，鼓起來了！"
 },
 {
  "key": "c9.down",
  "id": "d693273cfbc3",
  "text": "放開，後面的肌肉把手拉直。"
 },
 {
  "key": "c9.end",
  "id": "4bd7fbc0361a",
  "text": "肌肉只會拉，不會推。彎手、伸手，靠兩條肌肉輪流拉。"
 },
 {
  "key": "c10.title",
  "id": "a969ac3a432f",
  "text": "皮膚和睡覺"
 },
 {
  "key": "c10.s1",
  "id": "74cf9c91914d",
  "text": "皮膚像一件外套，包住整個身體。"
 },
 {
  "key": "c10.task",
  "id": "f8b3c85c74f3",
  "text": "細菌跳過來了！點一點，把它們彈開。"
 },
 {
  "key": "c10.ok",
  "id": "9b090842d846",
  "text": "皮膚把細菌擋在外面了！"
 },
 {
  "key": "c10.sleep",
  "id": "b5f250bbbbf3",
  "text": "膝蓋有個小傷口。點月亮，讓小人睡覺。"
 },
 {
  "key": "c10.heal",
  "id": "30ca56d433fb",
  "text": "睡著的時候，身體在修理，傷口慢慢長好了。"
 },
 {
  "key": "c10.end",
  "id": "13a32d078b2b",
  "text": "皮膚保護你；睡覺的時候，身體在修理，也在長大。"
 },
 {
  "key": "sum.1",
  "id": "4cecc2d4b66a",
  "text": "一口飯，從嘴巴走到大腸，變成你的力氣。"
 },
 {
  "key": "sum.2",
  "id": "2e172c16c852",
  "text": "心臟和肺，把氧氣送到全身；骨頭和肌肉，讓你站起來、跑起來。"
 },
 {
  "key": "sum.3",
  "id": "97e86160ef21",
  "text": "好好吃飯、喝水、運動、睡覺，就是在照顧你的身體。"
 },
 {
  "key": "fin.title",
  "id": "b71320f8e558",
  "text": "身體小博士"
 }
]