[
 {
  "key": "intro.1",
  "id": "e5501c6acd0f",
  "text": "咦？蘋果浮在水上，葡萄卻沉下去了。為什麼呢？"
 },
 {
  "key": "intro.2",
  "id": "a0312c4825c9",
  "text": "我們來當科學家！科學家會先假設，再做實驗，然後看結果。"
 },
 {
  "key": "intro.3",
  "id": "33612fd0410a",
  "text": "點亮亮的水缸，開始第一個實驗。"
 },
 {
  "key": "desk.idle",
  "id": "d36f2aaa19a8",
  "text": "點亮亮的那一個，開始下一個實驗。"
 },
 {
  "key": "desk.locked",
  "id": "067c24ba07fc",
  "text": "這個還沒開，先做亮亮的那一個。"
 },
 {
  "key": "g.h1",
  "id": "f0352643399b",
  "text": "假設，就是先猜猜看。"
 },
 {
  "key": "g.x1",
  "id": "bf12f11aae4a",
  "text": "實驗，就是動手試試看。"
 },
 {
  "key": "g.r1",
  "id": "8a61c73c5237",
  "text": "結果，就是看看真的發生了什麼事。"
 },
 {
  "key": "g.match",
  "id": "698474111a41",
  "text": "把每一個東西，連到你猜的答案。"
 },
 {
  "key": "g.choose",
  "id": "13421b8a3e03",
  "text": "選一個你猜的答案。"
 },
 {
  "key": "g.same",
  "id": "613ffee5964e",
  "text": "跟你的假設一樣！"
 },
 {
  "key": "g.diff",
  "id": "0fb4b69ca58d",
  "text": "跟你猜的不一樣，太好了，這就是新發現！"
 },
 {
  "key": "g.fixm",
  "id": "d28ba78f93bf",
  "text": "把線改接到真的結果。"
 },
 {
  "key": "g.fixc",
  "id": "395f3ed92200",
  "text": "把答案換成真的結果。"
 },
 {
  "key": "g.nope",
  "id": "216ffad08481",
  "text": "再看看剛剛實驗的結果。"
 },
 {
  "key": "g.again",
  "id": "fdd43748b1a8",
  "text": "再來一圈！"
 },
 {
  "key": "g.book",
  "id": "8cd77d744235",
  "text": "把這一頁，貼進記錄本。"
 },
 {
  "key": "n.apple",
  "id": "f5dcebad6e04",
  "text": "蘋果。"
 },
 {
  "key": "n.grape",
  "id": "ea11de9bb3f4",
  "text": "葡萄。"
 },
 {
  "key": "n.stone",
  "id": "4059fe831e37",
  "text": "石頭。"
 },
 {
  "key": "n.wood",
  "id": "be5a62e4d86e",
  "text": "木塊。"
 },
 {
  "key": "a.float",
  "id": "0f4fe500375b",
  "text": "浮起來。"
 },
 {
  "key": "a.sink",
  "id": "bf9d95d32684",
  "text": "沉下去。"
 },
 {
  "key": "n.clip",
  "id": "2ee23f6c7f97",
  "text": "迴紋針。"
 },
 {
  "key": "n.nail",
  "id": "b128f39c5028",
  "text": "鐵釘。"
 },
 {
  "key": "n.spoon",
  "id": "bedc15312607",
  "text": "木湯匙。"
 },
 {
  "key": "n.eraser",
  "id": "cd4cb808f63b",
  "text": "橡皮擦。"
 },
 {
  "key": "n.alcan",
  "id": "4cad06a8fbd6",
  "text": "鋁罐。"
 },
 {
  "key": "n.coin",
  "id": "11fc26810f26",
  "text": "十元硬幣。"
 },
 {
  "key": "n.tin",
  "id": "2f9bfd2090ce",
  "text": "鐵罐。"
 },
 {
  "key": "a.yes",
  "id": "e05d16a11076",
  "text": "會被吸住。"
 },
 {
  "key": "a.no",
  "id": "f86e7f79f79f",
  "text": "不會被吸住。"
 },
 {
  "key": "n.sugar",
  "id": "91d97d28524e",
  "text": "糖。"
 },
 {
  "key": "n.salt",
  "id": "9faa414262d1",
  "text": "鹽。"
 },
 {
  "key": "n.sand",
  "id": "5f542389d267",
  "text": "沙子。"
 },
 {
  "key": "n.pebble",
  "id": "f9783d1d7fe1",
  "text": "小石頭。"
 },
 {
  "key": "a.gone",
  "id": "fe23b93f9317",
  "text": "不見了。"
 },
 {
  "key": "a.still",
  "id": "57e9be27f849",
  "text": "還在。"
 },
 {
  "key": "o.far",
  "id": "5a5620bea1d8",
  "text": "比較遠。"
 },
 {
  "key": "o.near",
  "id": "9fc62766964c",
  "text": "比較近。"
 },
 {
  "key": "o.same",
  "id": "0bf4cd8fb0ef",
  "text": "差不多。"
 },
 {
  "key": "o.big",
  "id": "0e2ec6a73ec0",
  "text": "變大。"
 },
 {
  "key": "o.small",
  "id": "4b26b211ef17",
  "text": "變小。"
 },
 {
  "key": "o.warm",
  "id": "525f5c4aab3d",
  "text": "溫水。"
 },
 {
  "key": "o.cold",
  "id": "7a30eac4dd27",
  "text": "冷水。"
 },
 {
  "key": "o.fast",
  "id": "72c42683452e",
  "text": "比較快。"
 },
 {
  "key": "o.slow",
  "id": "f8d976b75581",
  "text": "比較慢。"
 },
 {
  "key": "o.none",
  "id": "78add02e1c89",
  "text": "不發芽。"
 },
 {
  "key": "o.equal",
  "id": "fc3f8bc45441",
  "text": "長得一樣。"
 },
 {
  "key": "o.tall",
  "id": "70c6db5d522c",
  "text": "長得更高。"
 },
 {
  "key": "o.green",
  "id": "075529b6433c",
  "text": "會變綠。"
 },
 {
  "key": "o.nogreen",
  "id": "b446c3d7ee32",
  "text": "不會變綠。"
 },
 {
  "key": "o.iron",
  "id": "a0583d316e22",
  "text": "鐵球先到。"
 },
 {
  "key": "o.woodb",
  "id": "7637efc22c2a",
  "text": "木球先到。"
 },
 {
  "key": "o.both",
  "id": "f8e89a746eca",
  "text": "差不多一起到。"
 },
 {
  "key": "o.flat",
  "id": "9333a362a498",
  "text": "攤開的先到。"
 },
 {
  "key": "o.ball",
  "id": "8e1f1ba1e241",
  "text": "紙團先到。"
 },
 {
  "key": "o.wet",
  "id": "610bc992b3b2",
  "text": "會濕。"
 },
 {
  "key": "o.dry",
  "id": "27631fbe2bf2",
  "text": "不會濕。"
 },
 {
  "key": "o.bigcar",
  "id": "2c1777d7a470",
  "text": "大車比較遠。"
 },
 {
  "key": "o.smallcar",
  "id": "8f88595cbd7d",
  "text": "小車比較遠。"
 },
 {
  "key": "e1.q",
  "id": "079db591a7bf",
  "text": "咦？哪些東西放進水裡會浮起來，哪些會沉下去？"
 },
 {
  "key": "e1.x1",
  "id": "9e11e2256375",
  "text": "把東西一個一個拖進水缸，放手看看。"
 },
 {
  "key": "e1.r1",
  "id": "1c77ca22d039",
  "text": "蘋果和木塊浮起來，葡萄和石頭沉下去了。"
 },
 {
  "key": "e1.q2",
  "id": "762df5d67938",
  "text": "咦，那橘子呢？會浮，還是會沉？"
 },
 {
  "key": "e1.x2",
  "id": "092fd49ec335",
  "text": "把橘子放進水裡。"
 },
 {
  "key": "e1.r2",
  "id": "e2bf02f980dc",
  "text": "橘子浮起來了！"
 },
 {
  "key": "e1.q3",
  "id": "0cd57c615b1c",
  "text": "那剝了皮的橘子呢？"
 },
 {
  "key": "e1.x3",
  "id": "7d9aa9ee654a",
  "text": "在橘子上畫一圈，把皮剝掉，再放進水裡。"
 },
 {
  "key": "e1.r3",
  "id": "6a37a13112e4",
  "text": "剝了皮的橘子，沉下去了！"
 },
 {
  "key": "e1.end",
  "id": "c0def748d0c5",
  "text": "所以，會不會浮，用看的看不出來，要放進水裡試。橘子皮裡有好多小空氣，像救生衣一樣。"
 },
 {
  "key": "e2.q",
  "id": "e099b77b4725",
  "text": "磁鐵會吸住哪些東西呢？"
 },
 {
  "key": "e2.x1",
  "id": "71bf704b4182",
  "text": "拿著磁鐵，慢慢掃過每一個東西。"
 },
 {
  "key": "e2.r1",
  "id": "c93dacc396eb",
  "text": "迴紋針和鐵釘被吸起來了，木湯匙和橡皮擦一動也不動。"
 },
 {
  "key": "e2.q2",
  "id": "520d2862d1ad",
  "text": "咦，迴紋針和鐵釘都是金屬。那金屬都會被吸住嗎？"
 },
 {
  "key": "e2.x2",
  "id": "b2f5ef0346d5",
  "text": "再拿磁鐵掃掃看。"
 },
 {
  "key": "e2.r2",
  "id": "630738242e55",
  "text": "只有鐵罐被吸住，鋁罐和十元硬幣都沒有。"
 },
 {
  "key": "e2.end",
  "id": "31b9bc28ed26",
  "text": "所以，磁鐵吸的是鐵做的東西，不是每一種金屬都會被吸住。"
 },
 {
  "key": "e3.q",
  "id": "ffb3bd628d10",
  "text": "車子從斜坡滑下來。坡高一點，車子會跑比較遠，還是比較近？"
 },
 {
  "key": "e3.x1",
  "id": "39192b74d404",
  "text": "先用低低的坡，放一次車。"
 },
 {
  "key": "e3.x1b",
  "id": "b415ddba88c5",
  "text": "再把坡往上拉高，放一次。"
 },
 {
  "key": "e3.r1",
  "id": "2a1eb7f2c56f",
  "text": "坡高的時候，車子跑得比較遠。"
 },
 {
  "key": "e3.q2",
  "id": "17b9ad8dd2b7",
  "text": "咦，那換一台大車呢？大車會跑比較遠嗎？"
 },
 {
  "key": "e3.x2",
  "id": "4c42585205f4",
  "text": "放大車。"
 },
 {
  "key": "e3.u2",
  "id": "b353ae620e7a",
  "text": "大車跑好遠！可是等一下，車子換了，坡也變高了。兩件事都變了，這樣不公平。點一個箭頭，把一件事改回來。"
 },
 {
  "key": "e3.x2b",
  "id": "077ccf566ec9",
  "text": "再放一次。"
 },
 {
  "key": "e3.r2",
  "id": "98b0eb7e7ce2",
  "text": "大車和小車，跑得差不多遠。跑得遠，是因為坡高，不是因為車子大。"
 },
 {
  "key": "e3.q3",
  "id": "bdb1b02e417f",
  "text": "如果地上鋪一條毛巾呢？"
 },
 {
  "key": "e3.x3",
  "id": "c8f58b555eb4",
  "text": "把毛巾拖到地上，再放車。"
 },
 {
  "key": "e3.r3",
  "id": "c2143dbc3ce5",
  "text": "有毛巾，車子跑得近多了。"
 },
 {
  "key": "e3.end",
  "id": "e993e17df57a",
  "text": "所以，坡越高，車子跑越遠；毛巾會讓車子慢下來。比的時候，一次只改一件事，才公平。"
 },
 {
  "key": "e4.q",
  "id": "e3de16282580",
  "text": "手電筒照著小人偶，牆上有影子。燈靠近人偶，影子會變大，還是變小？"
 },
 {
  "key": "e4.x1",
  "id": "e46c4e3db3fd",
  "text": "把手電筒往人偶拖過去。"
 },
 {
  "key": "e4.r1",
  "id": "1171d6600d2f",
  "text": "燈越靠近，影子越大！"
 },
 {
  "key": "e4.q2",
  "id": "266be37938ed",
  "text": "牆上有一顆星星。要讓影子的頭剛好碰到星星，燈要放在哪裡？"
 },
 {
  "key": "e4.h2",
  "id": "9ea7a9ac0642",
  "text": "先把燈的記號，放在你猜的地方。"
 },
 {
  "key": "e4.x2",
  "id": "aed7fb3e25ba",
  "text": "按開燈，看看影子。"
 },
 {
  "key": "e4.hit",
  "id": "b1374dfd95d7",
  "text": "碰到星星了！"
 },
 {
  "key": "e4.low",
  "id": "ff0c31445c2b",
  "text": "影子太小，還沒碰到。燈要再靠近一點，再猜一次。"
 },
 {
  "key": "e4.high",
  "id": "7aca82ed9aa3",
  "text": "影子太大，超過星星了。燈要再遠一點，再猜一次。"
 },
 {
  "key": "e4.end",
  "id": "d7b5f921a06d",
  "text": "所以，燈越近，影子越大。知道了規律，就能先猜到結果。"
 },
 {
  "key": "e5.q",
  "id": "0c7ca40cafa0",
  "text": "把東西放進水裡，攪一攪，哪些會不見？"
 },
 {
  "key": "e5.x1",
  "id": "7143cc78d57c",
  "text": "用湯匙舀一匙，倒進杯子，再畫圈攪一攪。"
 },
 {
  "key": "e5.r1",
  "id": "b5cbd027f6ee",
  "text": "糖和鹽不見了，沙子和小石頭還在杯底。"
 },
 {
  "key": "e5.mag",
  "id": "2dedf7b7e0a8",
  "text": "糖真的消失了嗎？把放大鏡拿到糖水上看看。"
 },
 {
  "key": "e5.mag2",
  "id": "c9d73abcc70b",
  "text": "原來，糖變成很小很小的點點，躲在水裡面。"
 },
 {
  "key": "e5.q2",
  "id": "69ae87c59383",
  "text": "溫水和冷水，哪一杯的糖會比較快不見？"
 },
 {
  "key": "e5.x2",
  "id": "bc0a4683755a",
  "text": "兩杯一起，畫圈攪一攪。"
 },
 {
  "key": "e5.r2",
  "id": "90c9e958b1f9",
  "text": "溫水那杯，糖先不見了！"
 },
 {
  "key": "e5.end",
  "id": "d7a788cbbba1",
  "text": "所以，糖沒有消失，是變成很小的點點，躲在水裡；水越溫，躲得越快。"
 },
 {
  "key": "e6.q",
  "id": "dddd3b8aaebd",
  "text": "冰塊穿上毛巾外套，會比較快融化，還是比較慢？"
 },
 {
  "key": "e6.x1",
  "id": "6c1f245bb1e3",
  "text": "把毛巾拖過去，包住一塊冰。"
 },
 {
  "key": "e6.clock",
  "id": "007bc097a290",
  "text": "轉轉時鐘，讓時間快快過去。"
 },
 {
  "key": "e6.lift",
  "id": "51e62d7c63ce",
  "text": "沒包的冰融完了。掀開毛巾看看。"
 },
 {
  "key": "e6.r1",
  "id": "96155d8f3a17",
  "text": "包著毛巾的冰，還在！它融得比較慢。"
 },
 {
  "key": "e6.q2",
  "id": "b884d5016257",
  "text": "那熱可可包上毛巾，會比較快涼，還是比較慢涼？"
 },
 {
  "key": "e6.x2",
  "id": "8e4c6497f6d7",
  "text": "包住一杯，再轉轉時鐘。"
 },
 {
  "key": "e6.r2",
  "id": "3a902bff3124",
  "text": "沒包的那杯不冒煙了，包著的還熱熱的。"
 },
 {
  "key": "e6.end",
  "id": "a95ffd84a528",
  "text": "所以，外套自己不會變熱。它是把熱擋住：外面的熱進不去，裡面的熱出不來。"
 },
 {
  "key": "e7.q",
  "id": "94374f6623d6",
  "text": "兩盆綠豆，一盆蓋上黑箱子。箱子裡的豆子，會怎麼樣？"
 },
 {
  "key": "e7.x1",
  "id": "f7ab4a8ba63e",
  "text": "每天澆水，掀開箱子看一眼，再撕一張日曆。"
 },
 {
  "key": "e7.r1",
  "id": "be160514877f",
  "text": "箱子裡的豆子長得更高，可是又黃又細，軟軟的。"
 },
 {
  "key": "e7.q2",
  "id": "65a41caf12fd",
  "text": "把箱子拿掉，放到窗邊，它會變綠嗎？"
 },
 {
  "key": "e7.x2",
  "id": "e6734e25470b",
  "text": "把箱子拿走，再澆水、撕日曆，過幾天。"
 },
 {
  "key": "e7.r2",
  "id": "457f75a483f5",
  "text": "慢慢變綠了！葉子也打開了。"
 },
 {
  "key": "e7.end",
  "id": "b11dd8064129",
  "text": "所以，豆子發芽不用光；可是要長得綠、長得壯，就要有光。"
 },
 {
  "key": "e8.q",
  "id": "ba31bf34a67d",
  "text": "大鐵球和小木球，同時放開，誰會先落地？"
 },
 {
  "key": "e8.x1",
  "id": "5845b445283a",
  "text": "兩個夾子，一起放開。"
 },
 {
  "key": "e8.one",
  "id": "d05b55ed0d8b",
  "text": "要兩個一起放，才比得出來。"
 },
 {
  "key": "e8.more",
  "id": "a158cc774fb9",
  "text": "再放一次，看看是不是每次都一樣。"
 },
 {
  "key": "e8.r1",
  "id": "87eb066c8177",
  "text": "三次都一樣，差不多一起落地！"
 },
 {
  "key": "e8.q2",
  "id": "50de69a0e725",
  "text": "兩張一樣的紙，一張揉成紙團。誰會先落地？"
 },
 {
  "key": "e8.x2",
  "id": "0e2177e6338a",
  "text": "按住一張紙，把它捏成紙團，再兩個一起放。"
 },
 {
  "key": "e8.r2",
  "id": "1d857ee3b41d",
  "text": "紙團先到！攤開的紙，飄呀飄，慢慢下來。"
 },
 {
  "key": "e8.end",
  "id": "f3409f06a294",
  "text": "所以，重的和輕的，差不多一起落地；攤開的紙比較慢，是空氣在托著它。"
 },
 {
  "key": "e9.q",
  "id": "f2150e594cf4",
  "text": "杯底塞一張紙巾，倒過來，直直壓進水裡。紙巾會濕嗎？"
 },
 {
  "key": "e9.x0",
  "id": "48583066e02d",
  "text": "先把紙巾塞進杯子底。"
 },
 {
  "key": "e9.x1",
  "id": "176cc443ff93",
  "text": "把杯子直直往下壓，再拿起來。"
 },
 {
  "key": "e9.touch",
  "id": "5c25c16e54d4",
  "text": "摸摸看紙巾。"
 },
 {
  "key": "e9.r1",
  "id": "ae8224d396a6",
  "text": "紙巾是乾的！"
 },
 {
  "key": "e9.q2",
  "id": "e45effb40355",
  "text": "咦，那杯子在水裡歪一下呢？"
 },
 {
  "key": "e9.x2",
  "id": "0766f415c12a",
  "text": "壓下去以後，把杯子歪一邊。"
 },
 {
  "key": "e9.r2",
  "id": "4c8ebad3cdcd",
  "text": "泡泡跑出來，水跑進去，紙巾濕了。"
 },
 {
  "key": "e9.end",
  "id": "c0ff1fa6ba92",
  "text": "所以，杯子裡不是空的，裝滿了空氣；空氣佔著位子，水就進不去。"
 },
 {
  "key": "e10.q",
  "id": "2c45451143bf",
  "text": "最後一個，是你自己的實驗！一張鋁箔，可以做成一條船。"
 },
 {
  "key": "e10.how",
  "id": "05d4c0cfd8b1",
  "text": "點圓圈上亮的那一格，自己走一圈：先假設，再實驗，然後看結果。"
 },
 {
  "key": "e10.end",
  "id": "ee0981560237",
  "text": "寬寬平平的船，載得最多。你自己做完一個完整的實驗了！"
 },
 {
  "key": "sum.0",
  "id": "bdfaccf7a586",
  "text": "十個實驗都做完了！來看看我們發現了什麼。"
 },
 {
  "key": "sum.match",
  "id": "0698627f4f5a",
  "text": "把每一個實驗，連到它的結果。"
 },
 {
  "key": "sum.book",
  "id": "f682efe41db7",
  "text": "翻翻記錄本，你做了好多次實驗！"
 },
 {
  "key": "sum.1",
  "id": "80078f60338f",
  "text": "每一次，我們都先假設，再做實驗，然後看結果。"
 },
 {
  "key": "sum.2",
  "id": "96ae0017154c",
  "text": "有時候跟猜的一樣，有時候不一樣，兩種都學到新東西。"
 },
 {
  "key": "sum.3",
  "id": "e7d1a7288abe",
  "text": "科學，就是這樣一次一次學習的過程。"
 },
 {
  "key": "sum.4",
  "id": "1d7105b7e216",
  "text": "下次看到奇怪的事，就說：我來試試看！"
 },
 {
  "key": "sum.free",
  "id": "940a56a4fe5f",
  "text": "每個實驗都可以再玩，記錄本也可以翻。"
 },
 {
  "key": "k1",
  "id": "cf4f3f670cd0",
  "text": "會不會浮，要試了才知道。"
 },
 {
  "key": "k2",
  "id": "bf32bba86ce0",
  "text": "磁鐵吸鐵做的東西。"
 },
 {
  "key": "k3",
  "id": "c99f23ab125d",
  "text": "坡越高，車子跑越遠。"
 },
 {
  "key": "k4",
  "id": "4781085396b4",
  "text": "燈越近，影子越大。"
 },
 {
  "key": "k5",
  "id": "64b15f47c581",
  "text": "糖躲進水裡了。"
 },
 {
  "key": "k6",
  "id": "a19a7d94dfe2",
  "text": "外套把熱擋住了。"
 },
 {
  "key": "k7",
  "id": "3608d470ced1",
  "text": "豆子有光，才會綠。"
 },
 {
  "key": "k8",
  "id": "b715148fd015",
  "text": "重的輕的，一起落地。"
 },
 {
  "key": "k9",
  "id": "4a72c2eec6f2",
  "text": "空氣佔著位子。"
 },
 {
  "key": "k10",
  "id": "08cead0d1778",
  "text": "寬寬平平的船，載最多。"
 }
]