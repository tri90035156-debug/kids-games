[
 {
  "key": "intro.1",
  "id": "a931bc8b0675",
  "text": "我們來做一台機器人。"
 },
 {
  "key": "intro.2",
  "id": "02fb931853d6",
  "text": "機器人，就是會自己動、幫人做事的機器。"
 },
 {
  "key": "step.r",
  "id": "01085d1eef36",
  "text": "很久很久以前，人就想要一個會自己動的幫手。第一步，先想好它要做什麼，畫成設計圖。"
 },
 {
  "key": "step.o1",
  "id": "f961cafcb7ba",
  "text": "大約兩百五十年前，有人用齒輪和發條，做出會拿筆寫字的人偶。齒輪轉一轉，身體就會動。"
 },
 {
  "key": "step.b",
  "id": "6e3d35ca5ffa",
  "text": "後來有了電和馬達。馬達裝在關節裡，手臂就有力氣。第一台在工廠工作的機器人，幫人搬很燙的金屬。"
 },
 {
  "key": "step.o2",
  "id": "449015ac5d3c",
  "text": "接著，人幫它裝上攝影機當眼睛。這樣它就看得到前面有什麼。"
 },
 {
  "key": "step.t",
  "id": "9d926df202f3",
  "text": "最後，電腦變得好小，裝進頭裡當腦袋。人寫好程式，告訴它要做什麼。接上電，機器人動起來了！"
 },
 {
  "key": "g.intro",
  "id": "f564e5f0ad5c",
  "text": "齒輪要靠發條才會轉。用手指在畫面上轉圈圈，就是在轉它背後的鑰匙。轉一圈，走一步。旗子在兩步遠，轉兩圈，再放開手。"
 },
 {
  "key": "g.2",
  "id": "6ff147a39b3c",
  "text": "旗子更遠了。要轉幾圈呢？"
 },
 {
  "key": "g.3",
  "id": "54276cf414cd",
  "text": "這次地上的燈不亮了。邊轉邊數，數到剛剛好再放手。"
 },
 {
  "key": "g.short",
  "id": "cfc312b7d6a9",
  "text": "還差一點。下次多轉幾圈。"
 },
 {
  "key": "g.over",
  "id": "56c4149c9f6f",
  "text": "轉太多，撞到牆了。少轉一點試試看。"
 },
 {
  "key": "g.ok",
  "id": "f28be0f274ec",
  "text": "剛剛好，到了！"
 },
 {
  "key": "g.done",
  "id": "345f724dd8aa",
  "text": "發條轉幾圈，它就走幾步。以前的寫字人偶，也是靠發條和齒輪動起來的。"
 },
 {
  "key": "a.intro",
  "id": "48deaeae6c45",
  "text": "手臂有力氣了！點一下方塊，它就會把方塊搬到圓圈上。"
 },
 {
  "key": "a.2",
  "id": "0c4ad34348b9",
  "text": "兩塊方塊，一大一小。把它們疊起來。"
 },
 {
  "key": "a.3",
  "id": "bebc915551e7",
  "text": "三塊方塊，疊成一座高塔。"
 },
 {
  "key": "a.fall",
  "id": "fe152259dfe1",
  "text": "哎呀，倒了！大的放下面，才會穩。"
 },
 {
  "key": "a.ok",
  "id": "e3b5cf3395a2",
  "text": "疊好了！"
 },
 {
  "key": "a.done",
  "id": "8b57a49034bc",
  "text": "工廠裡的機器人手臂，每天就這樣搬東西、疊整齊。"
 },
 {
  "key": "e.intro",
  "id": "159f895b8808",
  "text": "燈關掉了，好暗。在畫面上揮揮手，叫醒它的眼睛。"
 },
 {
  "key": "e.look",
  "id": "fd161d74ebd3",
  "text": "眼睛亮了！你的手指移到哪裡，它就看哪裡。幫它找出藏起來的方塊。"
 },
 {
  "key": "e.2",
  "id": "667ec4b7f7a8",
  "text": "這次藏了兩塊。"
 },
 {
  "key": "e.3",
  "id": "70b15c539d24",
  "text": "最後三塊，藏得更遠喔。"
 },
 {
  "key": "e.found",
  "id": "46aab3837a30",
  "text": "找到了！"
 },
 {
  "key": "e.ok",
  "id": "95a7fc40cfcc",
  "text": "全部找到了！"
 },
 {
  "key": "e.done",
  "id": "8d3d9490e80b",
  "text": "以前有一台機器人，就是用攝影機在房間裡看路、找箱子、推箱子。"
 },
 {
  "key": "p.boot",
  "id": "e286ca46d74f",
  "text": "把手指按在它頭上的小電腦，按住不放，幫它接上電。"
 },
 {
  "key": "p.intro",
  "id": "125f7d9c3421",
  "text": "電腦照著程式做事。點箭頭，排好它要走的每一步，再按播放。"
 },
 {
  "key": "p.2",
  "id": "a9526f4473c2",
  "text": "前面有木樁，要用跳的跳過去。"
 },
 {
  "key": "p.3",
  "id": "69845d0327aa",
  "text": "路變長了。一步一步想好，再按播放。"
 },
 {
  "key": "p.bump",
  "id": "e9f54547905a",
  "text": "撞到了！看看是哪一步要改。"
 },
 {
  "key": "p.short",
  "id": "a461cacf3c36",
  "text": "還沒走到，再加幾步。"
 },
 {
  "key": "p.ok",
  "id": "a7f9db695c5b",
  "text": "照著程式，走到了！"
 },
 {
  "key": "p.done",
  "id": "a128ad20dbb7",
  "text": "機器人自己不會想，它照著程式一步一步做。寫程式的人，就是你。"
 },
 {
  "key": "end.1",
  "id": "9f3e93d390d8",
  "text": "你剛剛做出了一台機器人！我們再看一次。"
 },
 {
  "key": "end.2",
  "id": "897472054501",
  "text": "你先畫了設計圖，就像很久以前的人，想要一個會自己動的幫手。"
 },
 {
  "key": "end.3",
  "id": "7c984385594b",
  "text": "你裝上齒輪，它有了會動的身體。"
 },
 {
  "key": "end.4",
  "id": "291a3a042ee3",
  "text": "你裝上馬達，它的手臂有了力氣。"
 },
 {
  "key": "end.5",
  "id": "e4b416624e30",
  "text": "你裝上攝影機，它看得到了。"
 },
 {
  "key": "end.6",
  "id": "5cccdfdf51ca",
  "text": "最後你裝上電腦腦袋，寫好程式，它就知道要做什麼。"
 },
 {
  "key": "end.7",
  "id": "eae713013a8c",
  "text": "以前的人花了兩百多年，一代一代加上新本事，才做出今天的機器人。你剛剛，就把這個故事走了一遍。"
 },
 {
  "key": "end.8",
  "id": "4d83767747de",
  "text": "機器人有會動的身體，小電腦是它的腦袋。英文叫做——"
 },
 {
  "key": "en.r",
  "id": "77f846fa25ee",
  "text": "R."
 },
 {
  "key": "en.o",
  "id": "bead2f89311e",
  "text": "O."
 },
 {
  "key": "en.b",
  "id": "1be80dd1890d",
  "text": "B."
 },
 {
  "key": "en.t",
  "id": "1a7e69efcb56",
  "text": "T."
 },
 {
  "key": "en.robot",
  "id": "9a8be3a030ec",
  "text": "Robot."
 }
]