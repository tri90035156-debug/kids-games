[
 {
  "key": "g.no1",
  "id": "9f92bda94f2a",
  "text": "再試試看。"
 },
 {
  "key": "g.no2",
  "id": "73728d51989c",
  "text": "沒關係，看看亮亮的地方。"
 },
 {
  "key": "g.again",
  "id": "6d15f300d1f7",
  "text": "再想想看！"
 },
 {
  "key": "intro.hi",
  "id": "d92825f5ea2c",
  "text": "颱風要來了！它是什麼呢？"
 },
 {
  "key": "intro.found",
  "id": "4c2e591c1ec5",
  "text": "我們一起去找颱風的祕密。"
 },
 {
  "key": "intro.press",
  "id": "be488d3f23d2",
  "text": "按出發，我們走吧！"
 },
 {
  "key": "c1.title",
  "id": "2d74acc10bed",
  "text": "嗨！這是颱風"
 },
 {
  "key": "c1.s1",
  "id": "9050d0ff5004",
  "text": "這是一個颱風，一大團轉圈圈的雲。"
 },
 {
  "key": "c1.s2",
  "id": "35cc33bfd5af",
  "text": "每個颱風都有名字，像這個叫做薔琵。"
 },
 {
  "key": "c1.s3",
  "id": "ee07cd2c0374",
  "text": "薔琵是寮國取的名字，是一種香香的花。"
 },
 {
  "key": "c1.s4",
  "id": "53fefff8aa67",
  "text": "颱風在很遠很遠的大海上出生。"
 },
 {
  "key": "c1.task",
  "id": "c34ed5af00f4",
  "text": "點一點颱風，叫它醒過來！"
 },
 {
  "key": "c1.more",
  "id": "f654f207f2db",
  "text": "它動了一下，再點一點！"
 },
 {
  "key": "c1.ok",
  "id": "64174a09d32d",
  "text": "颱風醒來了，開始轉圈圈！"
 },
 {
  "key": "c1.w1",
  "id": "15953190c397",
  "text": "颱風的名字，是十四個國家和地區一起取的，大家輪流用。"
 },
 {
  "key": "c1.w2",
  "id": "fc17eab35843",
  "text": "臺灣的中央氣象署，會幫它取一個中文名字。"
 },
 {
  "key": "c2.title",
  "id": "e78f2a693ae7",
  "text": "颱風怎麼生出來？"
 },
 {
  "key": "c2.s1",
  "id": "d0776f919238",
  "text": "太陽把大海曬得熱熱的。"
 },
 {
  "key": "c2.s2",
  "id": "8eb84470b1f2",
  "text": "熱熱的海水變成水蒸氣，一直往上飄。"
 },
 {
  "key": "c2.s3",
  "id": "da53efa7e6a5",
  "text": "水蒸氣飄到天上，變成雲。"
 },
 {
  "key": "c2.s4",
  "id": "8c0341ebbe99",
  "text": "好多好多雲聚在一起，就長成颱風。"
 },
 {
  "key": "c2.task",
  "id": "eca95157f9f7",
  "text": "點太陽，把海水曬熱！"
 },
 {
  "key": "c2.hot",
  "id": "cbab46f641eb",
  "text": "海水越來越熱了，再點一下！"
 },
 {
  "key": "c2.cloud",
  "id": "7ebade10dce9",
  "text": "水蒸氣往上飄，雲越長越高了！"
 },
 {
  "key": "c2.ok",
  "id": "542a3585174c",
  "text": "好多雲聚在一起轉起來，颱風生出來了！"
 },
 {
  "key": "c2.w1",
  "id": "1eac99cac725",
  "text": "海水要大約二十六度以上，才生得出颱風。"
 },
 {
  "key": "c2.w2",
  "id": "b42600296248",
  "text": "熱熱的海水，就像颱風的食物。"
 },
 {
  "key": "c2.w3",
  "id": "894d7d0bb738",
  "text": "夏天和秋天，南邊的海水最熱，所以颱風最常來。"
 },
 {
  "key": "c3.title",
  "id": "d7a2f5500e94",
  "text": "颱風為什麼會轉圈圈？"
 },
 {
  "key": "c3.s1",
  "id": "99b43accaacd",
  "text": "颱風中間的空氣一直往上跑，中間變得空空的。"
 },
 {
  "key": "c3.s2",
  "id": "cec02d994660",
  "text": "旁邊的風，就從四面八方衝過來補。"
 },
 {
  "key": "c3.s3",
  "id": "31eb1f7321c8",
  "text": "可是地球一直在轉，風跑著跑著就彎了。"
 },
 {
  "key": "c3.s4",
  "id": "d447136cba83",
  "text": "大家一起彎，就轉成一個大圈圈。"
 },
 {
  "key": "c3.task",
  "id": "1d6f4b64c2de",
  "text": "按「讓地球轉起來」，看看風怎麼跑。"
 },
 {
  "key": "c3.straight",
  "id": "975c058878ff",
  "text": "地球不轉的時候，風直直的衝到中間。"
 },
 {
  "key": "c3.curve",
  "id": "346728af955c",
  "text": "地球轉起來，風都往右邊彎，變成大圈圈！"
 },
 {
  "key": "c3.task2",
  "id": "718baaacbc41",
  "text": "換你轉！用手指畫圈，和時鐘反方向。"
 },
 {
  "key": "c3.wrong",
  "id": "c50b239ad5dd",
  "text": "轉反了！要和時鐘反方向轉。"
 },
 {
  "key": "c3.ok",
  "id": "0ecf924cc168",
  "text": "轉得好！在臺灣這邊，颱風都是這樣轉的。"
 },
 {
  "key": "c3.w1",
  "id": "01a7411d9bbf",
  "text": "在地球的北半球，颱風都是逆時針轉。"
 },
 {
  "key": "c3.w2",
  "id": "fa782d42b293",
  "text": "在南半球，颱風反過來，是順時針轉。"
 },
 {
  "key": "c3.w3",
  "id": "45ca5beedb0f",
  "text": "在赤道附近，地球轉的力量很小，很少有颱風。"
 },
 {
  "key": "c4.title",
  "id": "3cc0890667ad",
  "text": "颱風長什麼樣子？"
 },
 {
  "key": "c4.s1",
  "id": "acb3d7273a4b",
  "text": "從太空往下看，颱風像一個白白的大漩渦。"
 },
 {
  "key": "c4.s2",
  "id": "27b5bb934c48",
  "text": "大颱風的暴風圈，比整個臺灣還要大！"
 },
 {
  "key": "c4.task",
  "id": "e501fcf1fcfb",
  "text": "點點看：颱風眼、眼牆、雨帶。"
 },
 {
  "key": "c4.eye",
  "id": "b0df56979b08",
  "text": "颱風眼：正中間的小洞，裡面風很小。"
 },
 {
  "key": "c4.wall",
  "id": "b48ff2f44e35",
  "text": "眼牆：圍住颱風眼的厚厚雲牆，風雨最大！"
 },
 {
  "key": "c4.band",
  "id": "e0a5e14f4db2",
  "text": "雨帶：一圈一圈像手臂的雲，雨一陣大一陣小。"
 },
 {
  "key": "c4.tw",
  "id": "2ca536365609",
  "text": "看！大颱風的暴風圈，比臺灣還要大。"
 },
 {
  "key": "c4.ok",
  "id": "47e1cac8a881",
  "text": "三個地方都找到了！"
 },
 {
  "key": "c4.w1",
  "id": "a0d122354bb9",
  "text": "風在眼牆轉得太快，衝不進中間。"
 },
 {
  "key": "c4.w2",
  "id": "a232ea2dfa29",
  "text": "中間的空氣慢慢往下沉，雲散開，有時候看得到藍天。"
 },
 {
  "key": "c4.w3",
  "id": "07710a100052",
  "text": "颱風眼經過時，風雨突然停了，可是颱風還沒走！"
 },
 {
  "key": "c4.w4",
  "id": "0b4bba401a64",
  "text": "另一邊的眼牆馬上就來，要繼續待在家裡。"
 },
 {
  "key": "c5.title",
  "id": "0baa9137411c",
  "text": "颱風為什麼會走路？"
 },
 {
  "key": "c5.s1",
  "id": "cc6bef1535a6",
  "text": "颱風自己沒有腳。"
 },
 {
  "key": "c5.s2",
  "id": "ea2698ee952d",
  "text": "它是被身邊很大很大的風推著走的。"
 },
 {
  "key": "c5.s3",
  "id": "b644149fef3d",
  "text": "就像小河裡的樹葉，被水流帶著漂來漂去。"
 },
 {
  "key": "c5.task",
  "id": "71e4626064e6",
  "text": "按箭頭，或點一點圖，讓樹葉碰到三顆星星！"
 },
 {
  "key": "c5.star",
  "id": "b1374dfd95d7",
  "text": "碰到星星了！"
 },
 {
  "key": "c5.ok",
  "id": "ebcdf1763a5a",
  "text": "水流往哪裡，樹葉就往哪裡。颱風也是這樣！"
 },
 {
  "key": "c5.w1",
  "id": "4a707f2e7e6a",
  "text": "推著颱風走的大風，叫做駛流。"
 },
 {
  "key": "c5.w2",
  "id": "a663cedcca8d",
  "text": "颱風走路，常常和騎腳踏車差不多快。"
 },
 {
  "key": "c6.title",
  "id": "057bf152ac43",
  "text": "颱風通常怎麼走？"
 },
 {
  "key": "c6.s1",
  "id": "c89764936296",
  "text": "颱風通常從東南方的大海上來。"
 },
 {
  "key": "c6.s2",
  "id": "9202f510211a",
  "text": "東邊有一團好大的太平洋高氣壓。"
 },
 {
  "key": "c6.s3",
  "id": "4b7154e3976d",
  "text": "颱風推不動它，只好沿著它的邊邊走。"
 },
 {
  "key": "c6.task",
  "id": "f412b004a61e",
  "text": "按下面的按鈕，看看颱風的路會怎麼變。"
 },
 {
  "key": "c6.big",
  "id": "23dd81c50caa",
  "text": "高氣壓好大！颱風被擋住，一直往西走。"
 },
 {
  "key": "c6.mid",
  "id": "2ddb5d2ce731",
  "text": "高氣壓不大不小，颱風走到臺灣東邊才轉彎。"
 },
 {
  "key": "c6.small",
  "id": "13183053a440",
  "text": "高氣壓變小了！颱風很早就轉彎，跑去日本。"
 },
 {
  "key": "c6.task2",
  "id": "eaf59cace17a",
  "text": "再按「看颱風常走的路」。"
 },
 {
  "key": "c6.ok",
  "id": "875b256facce",
  "text": "颱風從東南方來，被高氣壓推著，經過臺灣附近再往北。"
 },
 {
  "key": "c6.w1",
  "id": "d0192c7cd6e3",
  "text": "秋天的時候，太平洋高氣壓常常變小，往東邊退。"
 },
 {
  "key": "c6.w2",
  "id": "74fe8d94aa19",
  "text": "北邊的西風也會來推，颱風就容易轉彎往北。"
 },
 {
  "key": "c6.w3",
  "id": "992f4881a1a3",
  "text": "所以秋天的颱風，常常在臺灣東邊轉彎。"
 },
 {
  "key": "c7.title",
  "id": "7a0f5ae71a03",
  "text": "颱風來了，怎麼辦？"
 },
 {
  "key": "c7.s1",
  "id": "f85379599b53",
  "text": "颱風靠近的時候，風很大、雨很多。"
 },
 {
  "key": "c7.s2",
  "id": "f122d9ab3141",
  "text": "山上可能下很大很大的雨。"
 },
 {
  "key": "c7.s3",
  "id": "7dbff6a87346",
  "text": "風雨太大的時候，會放颱風假。"
 },
 {
  "key": "c7.task",
  "id": "5d70c2a65a60",
  "text": "防颱小任務：颱風來了，這樣做好不好？"
 },
 {
  "key": "c7.k1",
  "id": "af3edd46a9e2",
  "text": "待在家裡"
 },
 {
  "key": "c7.k2",
  "id": "ace2e4338000",
  "text": "去海邊看大浪"
 },
 {
  "key": "c7.k3",
  "id": "470b0f5fbb43",
  "text": "準備手電筒和水"
 },
 {
  "key": "c7.k4",
  "id": "98e7d72045ad",
  "text": "把陽臺的花盆搬進來"
 },
 {
  "key": "c7.k5",
  "id": "4640261416e0",
  "text": "去山上的小溪玩水"
 },
 {
  "key": "c7.k6",
  "id": "f2c06fa2e027",
  "text": "在窗戶旁邊玩"
 },
 {
  "key": "c7.a1",
  "id": "08ea123e9567",
  "text": "對！待在家裡最安全。"
 },
 {
  "key": "c7.a2",
  "id": "b1429576f589",
  "text": "海邊的浪很大，會把人捲走，不可以去！"
 },
 {
  "key": "c7.a3",
  "id": "369bb86a9396",
  "text": "對！停電、停水的時候用得到。"
 },
 {
  "key": "c7.a4",
  "id": "bda44cc8fb9c",
  "text": "對！風很大，花盆會被吹下去打到人。"
 },
 {
  "key": "c7.a5",
  "id": "2e50889b6465",
  "text": "山上雨很大，溪水會突然變大，很危險！"
 },
 {
  "key": "c7.a6",
  "id": "3c508ef9f007",
  "text": "大風會吹破玻璃，要離窗戶遠一點。"
 },
 {
  "key": "c7.ok",
  "id": "2bf99213c1ef",
  "text": "防颱小任務完成！你知道怎麼保護自己了。"
 },
 {
  "key": "c7.w1",
  "id": "c25a3b95781f",
  "text": "颱風也有好處喔！它帶來很多雨，可以裝滿水庫。"
 },
 {
  "key": "c7.w2",
  "id": "2e2f0b273474",
  "text": "可是雨太多，山上的土石可能滑下來。"
 },
 {
  "key": "c7.w3",
  "id": "09d24ff2b431",
  "text": "所以颱風天，不要去山上。"
 },
 {
  "key": "c8.title",
  "id": "bfd3588225f5",
  "text": "經過臺灣以後，颱風去哪裡？"
 },
 {
  "key": "c8.s1",
  "id": "a33958ffeba3",
  "text": "很多颱風在臺灣東邊轉彎，往北走。"
 },
 {
  "key": "c8.s2",
  "id": "431ce787438f",
  "text": "它會經過沖繩旁邊的小島，跑進東海。"
 },
 {
  "key": "c8.s3",
  "id": "4babe4f096be",
  "text": "有的再往日本前進。"
 },
 {
  "key": "c8.task",
  "id": "8515daccfc13",
  "text": "按「繼續走」，陪颱風走完後面的路。"
 },
 {
  "key": "c8.p1",
  "id": "5031b6ed68b8",
  "text": "經過沖繩旁邊的小島，開始往北轉。"
 },
 {
  "key": "c8.p2",
  "id": "fe03a5fee89b",
  "text": "跑進東海，往日本前進。那裡的飛機也停飛了。"
 },
 {
  "key": "c8.p3",
  "id": "e2988c87506a",
  "text": "走到日本旁邊，力氣慢慢變小了。"
 },
 {
  "key": "c8.ok",
  "id": "b233298a5018",
  "text": "颱風的路可能會改變，要一直看氣象報告喔！"
 },
 {
  "key": "c8.w1",
  "id": "ead979944fd6",
  "text": "颱風的路很難猜，因為推著它的風一直在變。"
 },
 {
  "key": "c8.w2",
  "id": "4363073099d6",
  "text": "颱風警報的時候，氣象署每三小時就會再報告一次。"
 },
 {
  "key": "c8.w3",
  "id": "7c4c1213148f",
  "text": "很多國家的氣象專家，會一起追著颱風看。"
 },
 {
  "key": "c9.title",
  "id": "f75ffcf74960",
  "text": "颱風怎麼會消失？"
 },
 {
  "key": "c9.s1",
  "id": "7f9f2451af16",
  "text": "颱風的食物，是熱熱的海水。"
 },
 {
  "key": "c9.s2",
  "id": "96a7d1141744",
  "text": "跑到北邊冷冷的海，或是爬上陸地，就沒有食物了。"
 },
 {
  "key": "c9.s3",
  "id": "e55b25590341",
  "text": "高山和陸地還會絆住它，讓它沒有力氣。"
 },
 {
  "key": "c9.task",
  "id": "4f4f7e4faec5",
  "text": "拖著颱風去不同的地方，讓它的力氣變成零！"
 },
 {
  "key": "c9.warm",
  "id": "2a5c9bdc79c7",
  "text": "在熱熱的海上，颱風吃飽飽，力氣變大了！"
 },
 {
  "key": "c9.cold",
  "id": "09fa4837728f",
  "text": "冷冷的海沒有食物，力氣變小了。"
 },
 {
  "key": "c9.land",
  "id": "148a192cb9d5",
  "text": "爬上陸地，被高山絆住，力氣變小了。"
 },
 {
  "key": "c9.ok",
  "id": "67fa71652e61",
  "text": "颱風沒有力氣了，變成普通的低氣壓，慢慢散掉。"
 },
 {
  "key": "c9.w1",
  "id": "6d17de0d2e16",
  "text": "颱風跑到冷冷的海上，常常變成溫帶低氣壓，就不叫颱風了。"
 },
 {
  "key": "c9.w2",
  "id": "a748ee4dfae5",
  "text": "颱風變弱以後，還是可能下雨，要看完氣象報告才放心。"
 },
 {
  "key": "c10.title",
  "id": "43752f86d35f",
  "text": "你是颱風小博士！"
 },
 {
  "key": "c10.s1",
  "id": "15bd48b9784e",
  "text": "你知道了颱風怎麼生出來、為什麼會轉、長什麼樣子。"
 },
 {
  "key": "c10.s2",
  "id": "a53dbba475fd",
  "text": "還知道它會去哪裡、怎麼消失。"
 },
 {
  "key": "c10.s3",
  "id": "dea15b0d0c22",
  "text": "最後來考考你！"
 },
 {
  "key": "c10.q1",
