[
 {
  "key": "intro.1",
  "id": "db3792ecd7bb",
  "text": "這是我們做好的機器人。今天，它要出門接任務！"
 },
 {
  "key": "intro.2",
  "id": "80922f6debe0",
  "text": "用手指按住畫面，往哪邊拉，它就往哪邊開。也可以直接點亮亮的圓圈。"
 },
 {
  "key": "town.idle",
  "id": "bc9f7fdde412",
  "text": "開到亮亮的圓圈上，停一下，任務就開始了。"
 },
 {
  "key": "town.path",
  "id": "b9ddbea48fd4",
  "text": "跟著地上的點點走，就到了。"
 },
 {
  "key": "town.locked",
  "id": "7413cee801e4",
  "text": "這一站還沒開，先去亮亮的那一站。"
 },
 {
  "key": "m1.intro",
  "id": "38d4757b58a0",
  "text": "人行道上，有一種送貨機器人，會自己把包裹送到家門口。"
 },
 {
  "key": "m1.s1",
  "id": "300ea92d58c6",
  "text": "頭上頂著包裹，開到亮亮的門口，停下來。"
 },
 {
  "key": "m1.s2",
  "id": "e62ffbf19747",
  "text": "這次送兩家。路上有三角錐，要繞過去。"
 },
 {
  "key": "m1.s3",
  "id": "cc5c4ce522b5",
  "text": "送三家！小心，有球滾來滾去。"
 },
 {
  "key": "m1.drop",
  "id": "80983aefca16",
  "text": "轉彎太快，包裹掉了。開過去撿起來，轉彎慢一點。"
 },
 {
  "key": "m1.stop",
  "id": "56a601cdfdf1",
  "text": "在門口的圓圈上停下來，包裹才會送進去。"
 },
 {
  "key": "m1.ok",
  "id": "543c025a2985",
  "text": "包裹全部送到了！"
 },
 {
  "key": "m1.aha",
  "id": "d68e5ac3d17f",
  "text": "輪子在平路上跑得最快，可是要會轉彎、會停，包裹才不會掉。你得到一對大輪子！"
 },
 {
  "key": "m2.intro",
  "id": "a122147fc6e6",
  "text": "掃地機器人看不到牆。它一直往前走，碰到東西，就轉個彎。"
 },
 {
  "key": "m2.s1",
  "id": "a9091a20122f",
  "text": "角落有灰塵，可是椅子擋住了。把椅子拉開，讓它進去掃。"
 },
 {
  "key": "m2.s2",
  "id": "89aa82c99670",
  "text": "兩個房間，門口有箱子擋著。把箱子推開。"
 },
 {
  "key": "m2.s3",
  "id": "2750196cdc28",
  "text": "灰塵藏在地毯下面！把地毯拉開。"
 },
 {
  "key": "m2.stuck",
  "id": "7dae0b9bcec0",
  "text": "它一直碰到同一個東西，過不去。幫它把東西移開。"
 },
 {
  "key": "m2.ok",
  "id": "77d3d559a917",
  "text": "掃乾淨了！"
 },
 {
  "key": "m2.aha",
  "id": "de38e223cd6e",
  "text": "它不是用眼睛看，是碰到了，才知道前面有東西。你得到一個會亮的保險桿！"
 },
 {
  "key": "m3.intro",
  "id": "0480e904a1b4",
  "text": "工廠裡的機器手臂，同一個動作可以做好多好多次，又快又準。"
 },
 {
  "key": "m3.s1",
  "id": "f3333c3024c0",
  "text": "按住東西夾起來，放進一樣顏色的箱子。"
 },
 {
  "key": "m3.s2",
  "id": "dcb3c068f9df",
  "text": "三種顏色，輸送帶也動起來了。"
 },
 {
  "key": "m3.s3",
  "id": "f0708a30e834",
  "text": "這次看形狀！圓的放圓的箱子，方的放方的箱子。"
 },
 {
  "key": "m3.wrong",
  "id": "3185a8b30e17",
  "text": "不是這個箱子喔，看看顏色。"
 },
 {
  "key": "m3.wrong2",
  "id": "8226515480bc",
  "text": "看看形狀，是圓的還是方的？"
 },
 {
  "key": "m3.ok",
  "id": "9e6d39e8145d",
  "text": "全部分好了！"
 },
 {
  "key": "m3.aha",
  "id": "c8cf1e2b3c88",
  "text": "工廠的機器手臂，一天可以做好幾千次一樣的動作，也不會累。你得到一個夾子！"
 },
 {
  "key": "m4.intro",
  "id": "9ce494efbcec",
  "text": "火星好遠好遠。地球傳話給火星車，要等好幾分鐘它才收得到。"
 },
 {
  "key": "m4.s1",
  "id": "3939cfb86923",
  "text": "所以要先想好整條路。用手指畫一條路，繞過石頭到旗子，再按播放。"
 },
 {
  "key": "m4.s2",
  "id": "7e46e3ca27b7",
  "text": "石頭變多了，路要畫長一點。"
 },
 {
  "key": "m4.s3",
  "id": "60b395539507",
  "text": "先經過三個亮亮的小石頭，把它們撿起來，再到旗子。"
 },
 {
  "key": "m4.bump",
  "id": "65b76d2d4745",
  "text": "撞到石頭了。從這裡再畫一段。"
 },
 {
  "key": "m4.short",
  "id": "1efb1132f373",
  "text": "還沒到旗子，從這裡接著畫。"
 },
 {
  "key": "m4.sample",
  "id": "d7cee1752292",
  "text": "還有小石頭沒撿到喔。"
 },
 {
  "key": "m4.ok",
  "id": "606330596e6f",
  "text": "到了！拍一張照片，傳回地球。"
 },
 {
  "key": "m4.aha",
  "id": "5d30c73db27e",
  "text": "因為傳話要好久，火星車的路，都是人先在地球想好、一次傳過去的。你得到一支相機！"
 },
 {
  "key": "m5.intro",
  "id": "bd1110af56cc",
  "text": "無人機有四個螺旋槳。轉得快，它就往上飛。"
 },
 {
  "key": "m5.s1",
  "id": "1616a9428ccf",
  "text": "按住畫面，它就往上飛；放開，就慢慢降下來。往左右拉，就往那邊飛。飛到河的對岸。"
 },
 {
  "key": "m5.s2",
  "id": "2c6d92d36820",
  "text": "起風了，風往右邊吹。降落在對岸的圓圈裡。"
 },
 {
  "key": "m5.s3",
  "id": "894aadfaa319",
  "text": "這次要降落在河中間的小島上。"
 },
 {
  "key": "m5.splash",
  "id": "0d58ad8aa5aa",
  "text": "噗通！掉進水裡了。飛高一點再過河。"
 },
 {
  "key": "m5.miss",
  "id": "df07d4609900",
  "text": "差一點！要降落在圓圈裡面。"
 },
 {
  "key": "m5.ok",
  "id": "a99f70b1c5f6",
  "text": "降落成功！"
 },
 {
  "key": "m5.aha",
  "id": "631e50996a15",
  "text": "四個螺旋槳一起轉快，就往上飛；一邊快、一邊慢，就斜斜地飛過去。你得到一頂螺旋槳帽！"
 },
 {
  "key": "m6.intro",
  "id": "27b527f82410",
  "text": "水底下收不到訊號，所以水下機器人用一條長長的線，連到船上。"
 },
 {
  "key": "m6.s1",
  "id": "77fb32e7d500",
  "text": "往下拉，讓它潛下去，碰到東西就會夾起來。"
 },
 {
  "key": "m6.s2",
  "id": "2bb48f374e26",
  "text": "越深越暗。點燈泡，打開探照燈。"
 },
 {
  "key": "m6.s3",
  "id": "f8e46d0c24ff",
  "text": "這次東西好遠，線不夠長。先把船開到它的上面。"
 },
 {
  "key": "m6.dark",
  "id": "0e3c6a20e3ce",
  "text": "太暗了，看不到。打開探照燈試試。"
 },
 {
  "key": "m6.rope",
  "id": "2be59da9040b",
  "text": "線拉緊了，不能再遠了。把船移過去。"
 },
 {
  "key": "m6.ok",
  "id": "95a7fc40cfcc",
  "text": "全部找到了！"
 },
 {
  "key": "m6.aha",
  "id": "53f10a48b212",
  "text": "水裡沒有訊號，要靠線；深的地方沒有光，要自己帶燈。你得到一盞探照燈！"
 },
 {
  "key": "m7.intro",
  "id": "4edd9314659b",
  "text": "輪子爬不上樓梯，可是腳可以。這隻四腳機器狗，要一步一步往上走。"
 },
 {
  "key": "m7.s1",
  "id": "691db9279fe3",
  "text": "左腳、右腳，輪流按。跟著地上亮的燈走。"
 },
 {
  "key": "m7.s2",
  "id": "62b7d1ab3bf4",
  "text": "燈變快了，跟上它！"
 },
 {
  "key": "m7.s3",
  "id": "0e20af60b845",
  "text": "有一階壞掉了！走到它前面，同一隻腳快快按兩下，就跳過去。"
 },
 {
  "key": "m7.same",
  "id": "cc6017f88984",
  "text": "同一隻腳踩兩次，會跌倒喔。左、右、左、右。"
 },
 {
  "key": "m7.fast",
  "id": "fcbf21771305",
  "text": "慢一點，跟著燈的節奏。"
 },
 {
  "key": "m7.gap",
  "id": "eb6ef072636a",
  "text": "這一階壞了。同一隻腳快快按兩下，跳過去。"
 },
 {
  "key": "m7.ok",
  "id": "d8c19544b699",
  "text": "爬上去了！"
 },
 {
  "key": "m7.aha",
  "id": "976fa8972106",
  "text": "有腳就能爬樓梯，一步一步有節奏，才不會跌倒。你得到四條腿！在小鎮裡按腳的按鈕就能換。"
 },
 {
  "key": "m8.intro",
  "id": "46fcaff574c2",
  "text": "大倉庫裡，小機器人會鑽到架子底下，把整個架子抬起來搬走。"
 },
 {
  "key": "m8.s1",
  "id": "a302bf64dc63",
  "text": "鑽到有紅色記號的架子下面，把它搬到出口。"
 },
 {
  "key": "m8.s2",
  "id": "11bfbd1eb7d4",
  "text": "有別的架子擋路。推開它，讓出一條路。"
 },
 {
  "key": "m8.s3",
  "id": "a40185da32d2",
  "text": "另一台機器人會跟著你走。排好路，別讓它擋住你。"
 },
 {
  "key": "m8.block",
  "id": "2608b4f3b01d",
  "text": "推不動，後面卡住了。換一個方向試試。"
 },
 {
  "key": "m8.wait",
  "id": "b6b0f30e15c2",
  "text": "它在後面等你，換一條路走。"
 },
 {
  "key": "m8.ok",
  "id": "f841ebef4336",
  "text": "送到出口了！"
 },
 {
  "key": "m8.aha",
  "id": "41503d150a37",
  "text": "真的倉庫裡，好多小機器人一起走，地上有記號帶路，排好路才不會撞在一起。你得到一個升降盤！"
 },
 {
  "key": "m9.intro",
  "id": "8a7fda11bcf5",
  "text": "人的手會一點一點抖。有一種很精細的機器手，會把抖動拿掉，做很小的事。"
 },
 {
  "key": "m9.s1",
  "id": "2159686de189",
  "text": "用鑷子夾住小零件，沿著溝槽慢慢移，放進洞裡。"
 },
 {
  "key": "m9.s2",
  "id": "9b845cf45d92",
  "text": "彎彎的路，慢慢來。"
 },
 {
  "key": "m9.s3",
  "id": "692d42c1cbdd",
  "text": "路更細了，這次要放兩個小零件。"
 },
 {
  "key": "m9.drop",
  "id": "67f61608e4a5",
  "text": "偏出去了，零件掉下來。跟著溝槽，慢慢走。"
 },
 {
  "key": "m9.ok",
  "id": "79f77784d08e",
  "text": "修好了！音樂盒又會唱歌了。"
 },
 {
  "key": "m9.aha",
  "id": "adf87dca8b36",
  "text": "機器手可以比人的手更穩、更小。你得到一支小鑷子！"
 },
 {
  "key": "m10.intro",
  "id": "29e3b919114a",
  "text": "最後一關！沒有一台機器人什麼都會。看看前面的路，選對裝備。"
 },
 {
  "key": "m10.rule",
  "id": "6f4459e5804c",
  "text": "每次只能帶兩樣裝備。把裝備拖到機器人身上，再點前面的路出發。"
 },
 {
  "key": "m10.s1",
  "id": "5c0510061635",
  "text": "第一段是碎石路，什麼裝備走得過去呢？"
 },
 {
  "key": "m10.s2",
  "id": "6c4223e0f6b8",
  "text": "第二段是樓梯。"
 },
 {
  "key": "m10.s3",
  "id": "e37ef4b1743d",
  "text": "最後一段是小河。"
 },
 {
  "key": "m10.gravel",
  "id": "c6f2c8011b64",
  "text": "小輪子卡在碎石裡了。換大輪子，或是腳試試。"
 },
 {
  "key": "m10.stairs",
  "id": "7cf2ac2f5085",
  "text": "輪子爬不上樓梯，要換成腳。"
 },
 {
  "key": "m10.river",
  "id": "8890eb3c724a",
  "text": "過不了河。什麼裝備可以飛呢？"
 },
 {
  "key": "m10.ok",
  "id": "606ea10418d7",
  "text": "全部過關了！"
 },
 {
  "key": "m10.aha",
  "id": "1fafb96b07a9",
  "text": "每一種機器人，都是照它要做的工作設計的。"
 },
 {
  "key": "end.1",
  "id": "bbcfbf77ce9d",
  "text": "你和機器人，完成了十個任務！"
 },
 {
  "key": "end.2",
  "id": "fff1231e0f4c",
  "text": "每一種機器人都是先看、再想、再動，只是用的本事不一樣。"
 },
 {
  "key": "end.3",
  "id": "78ba26bc647a",
  "text": "每一站都可以再玩，點架子上的裝備，也可以換來換去。去逛逛吧！"
 }
]